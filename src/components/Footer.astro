---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n/useTranslations';
import type { Locale } from '../i18n/config';

const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);
const contactEmail = t('site.email');
const year = new Date().getFullYear();
const footerNav = tRaw<{ label: string; href: string }[]>('footer.navItems');
const exploreLabel = t('footer.exploreHeading');
const contactLabel = t('footer.contactHeading');
const markText = t('site.name').toUpperCase();

// dense strata lines clipped inside the letterforms; they fill the glyphs
// from the baseline up, layer by layer ("the layer beneath")
const strataYs = Array.from({ length: 17 }, (_, i) => 18 + i * 8);
---

<footer class="bg-graphite text-graphite-fg">
  <div class="container-x py-16 md:py-20">
    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <div class="max-w-xs">
        <Logo class="h-7 w-7" />
        <p class="mt-5 text-sm leading-relaxed text-graphite-fg-2">
          {t('footer.taglineAlt')}
        </p>
      </div>

      <nav aria-label={exploreLabel}>
        <p class="kicker text-graphite-fg-2">{exploreLabel}</p>
        <ul class="mt-5 grid grid-cols-2 gap-x-14 gap-y-2.5">
          {footerNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-graphite-fg-2 transition-colors hover:text-graphite-fg"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="kicker text-graphite-fg-2">{contactLabel}</p>
        <a
          href={`mailto:${contactEmail}`}
          class="mt-5 block text-sm text-accent-bright transition-colors hover:text-graphite-fg"
        >
          {contactEmail}
        </a>
        <p class="mt-4 font-mono text-xs leading-loose text-graphite-fg-2">
          {t('footer.locations')}
        </p>
      </div>
    </div>

    <div aria-hidden="true" class="mt-16 select-none md:mt-24" data-footer-mark>
      <svg
        viewBox="0 0 960 152"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <filter id="wm-inset-blur" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="2.6" />
          </filter>
          <clipPath id="wm-clip">
            <text
              class="wm-text"
              x="480"
              y="148"
              text-anchor="middle"
              textLength="940"
              lengthAdjust="spacing"
            >
              {markText}
            </text>
          </clipPath>
        </defs>
        <!-- bottom lip catching the light — sells the pressed-in depth -->
        <text
          class="wm-text wm-edge"
          data-wm-embed
          x="480"
          y="150"
          text-anchor="middle"
          textLength="940"
          lengthAdjust="spacing"
        >
          {markText}
        </text>
        <text
          class="wm-text wm-fill"
          x="480"
          y="148"
          text-anchor="middle"
          textLength="940"
          lengthAdjust="spacing"
        >
          {markText}
        </text>
        <!-- strata layers confined to the glyph interiors -->
        <g clip-path="url(#wm-clip)">
          {strataYs.map((y) => <path class="wm-strata" data-wm-draw d={`M10 ${y} H950`} />)}
        </g>
        <!-- inner shadow cast by the top edge of the cavity -->
        <g clip-path="url(#wm-clip)" data-wm-embed>
          <text
            class="wm-text wm-inner"
            x="480"
            y="151.5"
            text-anchor="middle"
            textLength="940"
            lengthAdjust="spacing"
            filter="url(#wm-inset-blur)"
          >
            {markText}
          </text>
        </g>
        <text
          class="wm-text wm-outline"
          x="480"
          y="148"
          text-anchor="middle"
          textLength="940"
          lengthAdjust="spacing"
        >
          {markText}
        </text>
        <text
          class="wm-text wm-glow"
          x="480"
          y="148"
          text-anchor="middle"
          textLength="940"
          lengthAdjust="spacing"
        >
          {markText}
        </text>
      </svg>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-graphite-line pt-6 text-graphite-fg-2 sm:flex-row sm:items-center sm:justify-between md:mt-16"
    >
      <p class="text-sm">&copy; {year} {t('footer.copyright')}</p>
      <p class="font-mono text-xs tracking-[0.14em]">{t('footer.tagline')}</p>
    </div>
  </div>
</footer>

<style>
  .wm-text {
    font-family: 'Bebas Neue', var(--font-display);
    font-size: 200px;
    letter-spacing: 0.02em;
  }
  /* darker than the surface so the letterforms read as a recessed cavity */
  .wm-fill {
    fill: color-mix(in srgb, black 26%, var(--c-graphite));
  }
  .wm-edge {
    fill: rgb(255 255 255 / 0.14);
  }
  .wm-inner {
    fill: none;
    stroke: rgb(0 0 0 / 0.55);
    stroke-width: 6;
  }
  .wm-outline {
    stroke: var(--c-graphite-line);
    stroke-width: 1.4;
  }
  /* traveling light segments along the letterforms; enabled by the motion
     script — stays invisible without JS or with reduced motion */
  .wm-glow {
    stroke: var(--c-accent);
    stroke-width: 1.4;
    opacity: 0;
    filter: drop-shadow(0 0 7px var(--c-accent));
  }
  .wm-strata {
    stroke: var(--c-graphite-line);
    stroke-width: 1;
    opacity: 0.6;
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../scripts/motion';

  const mark = document.querySelector<HTMLElement>('[data-footer-mark]');
  if (mark && !prefersReducedMotion()) {
    const fill = mark.querySelector('.wm-fill');
    const outline = mark.querySelector('.wm-outline');
    const glow = mark.querySelector('.wm-glow');
    const strata = Array.from(mark.querySelectorAll<SVGGeometryElement>('[data-wm-draw]'));
    const embeds = Array.from(mark.querySelectorAll<SVGElement>('[data-wm-embed]'));

    // text glyphs have no getTotalLength(); a dash longer than any glyph
    // perimeter lets every letter draw in from nothing
    const DASH = 2600;
    gsap.set(outline, { strokeDasharray: DASH, strokeDashoffset: DASH });
    gsap.set([fill, ...embeds], { opacity: 0 });
    strata.forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
    });

    ScrollTrigger.create({
      trigger: mark,
      start: 'top 95%',
      once: true,
      onEnter: () => {
        gsap.to(outline, { strokeDashoffset: 0, duration: 2.2, ease: 'power2.inOut' });
        gsap.to([fill, ...embeds], { opacity: 1, duration: 1.6, ease: 'power1.inOut', delay: 0.8 });
        // strata draw in bottom layer first — the glyphs fill up from the
        // baseline like accumulating sediment
        gsap.to(strata, {
          strokeDashoffset: 0,
          duration: 0.9,
          stagger: { each: 0.09, from: 'end' },
          ease: 'power1.out',
          delay: 0.5,
        });

        const period = 2600;
        gsap.set(glow, { strokeDasharray: `140 ${period - 140}`, strokeDashoffset: 140, opacity: 1 });
        gsap.to(glow, {
          strokeDashoffset: 140 - period,
          duration: 9,
          ease: 'none',
          repeat: -1,
          delay: 1.6,
        });
      },
    });
  }
</script>
