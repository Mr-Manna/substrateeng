---
import Logo from './Logo.astro';
import { navItems, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-graphite text-graphite-fg">
  <div class="container-x py-16 md:py-20">
    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <div class="max-w-xs">
        <Logo class="h-7 w-7" />
        <p class="mt-5 text-sm leading-relaxed text-graphite-fg-2">
          {site.tagline} We design, build, and operate the systems enterprises depend on.
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="kicker text-graphite-fg-2">Explore</p>
        <ul class="mt-5 grid grid-cols-2 gap-x-14 gap-y-2.5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-graphite-fg-2 transition-colors hover:text-graphite-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="kicker text-graphite-fg-2">Contact</p>
        <a
          href={`mailto:${site.email}`}
          class="mt-5 block text-sm text-accent-bright transition-colors hover:text-graphite-fg"
        >
          {site.email}
        </a>
        <p class="mt-4 font-mono text-xs leading-loose text-graphite-fg-2">
          LONDON · SINGAPORE · TORONTO
        </p>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-graphite-line pt-6 text-graphite-fg-2 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm">&copy; {year} Substrate. All rights reserved.</p>
      <p class="font-mono text-xs tracking-[0.14em]">ENGINEERED, NOT ASSEMBLED.</p>
    </div>
  </div>
</footer>
