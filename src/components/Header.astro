---
import Logo from './Logo.astro';
import ThemeToggle from './islands/ThemeToggle';
import MobileNav from './islands/MobileNav';
import { useTranslations } from '../i18n/useTranslations';
import { localeNames, locales } from '../i18n/config';
import type { Locale } from '../i18n/config';

const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);
const navItems = tRaw<{ label: string; href: string; items?: { label: string; href: string; items?: { label: string; href: string; description?: string }[] }[] }[]>('nav.items');
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent">
  <!-- The scrolled-state blur lives on its own layer rather than on
       #site-header. backdrop-filter makes an element the containing block for
       every position:fixed descendant, and MobileNav's full-screen panel is a
       descendant — on the header itself, the blur would resize that panel to
       the strip the moment the user scrolled. -->
  <div class="header-backdrop" aria-hidden="true"></div>

  <!-- `relative` is load-bearing, not decoration: .header-backdrop above is
       absolutely positioned, and positioned elements paint over non-positioned
       in-flow content whatever the DOM order. Without it the scrolled-state
       backdrop covers everything in the bar that isn't separately positioned. -->
  <div class="header-bar container-x relative flex h-16 items-center justify-between gap-3 md:h-[4.5rem]">
    <!-- Logo and readout share one flex slot so the bar keeps the same two
         children in both states. -->
    <div class="flex min-w-0 shrink items-center">
      <a href="/" class="header-logo shrink-0 text-ink flex items-center" aria-label={t('nav.home')}>
        <Logo class="h-7 w-7" />
      </a>

      <!-- Depth readout: which section you're currently in. Mirrors the kicker
           treatment in SectionHeading.astro, and is filled in from that
           component's data-section-* attributes. Hidden until the bar
           collapses. aria-hidden because it restates the section's own <h2>,
           which screen readers already reach by heading navigation. -->
      <p class="section-readout kicker" aria-hidden="true" data-readout>
        <span class="readout-index" data-readout-index></span>
        <span class="readout-label" data-readout-label></span>
      </p>
    </div>

    <!-- Navigation is not in the bar at any width — it lives behind the menu
         button, which is the last child here and therefore the one control
         whose position never depends on what else is showing. -->
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2.5">
      <!-- Locale switcher. Below lg the menu panel carries its own. -->
      <div class="locale-wrap hidden lg:relative lg:block">
        <button
          type="button"
          class="locale-toggle inline-flex h-9 w-9 items-center justify-center rounded-full text-xs font-mono font-medium text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink"
          aria-label={t('nav.switchLocale')}
        >
          {locale.toUpperCase()}
        </button>
        <div class="locale-dropdown absolute end-0 top-full mt-1 min-w-[9rem] rounded-lg border border-line bg-paper py-1.5 shadow-lg shadow-black/5 opacity-0 invisible transition-all duration-200">
          {locales.map((l) => (
            <a
              href={l === 'en' ? '/' : `/${l}/`}
              class={`block px-4 py-1.5 text-sm transition-colors hover:text-accent ${l === locale ? 'font-semibold text-accent' : 'text-ink-2'}`}
              hreflang={l}
            >
              {localeNames[l]}
            </a>
          ))}
        </div>
      </div>

      <ThemeToggle client:load />
      <a
        href="/contact"
        class="header-cta hidden whitespace-nowrap rounded-full border border-line-2 px-4.5 py-2 text-sm font-medium text-ink transition-colors hover:border-ink-2 hover:bg-paper-2 xl:inline-flex"
      >
        {t('buttons.startConversation')}
      </a>

      <!-- The mark goes through as a named slot rather than being rebuilt in
           the island: MobileNav is React and Logo is an Astro component, and a
           second copy of the SVG is a second thing to update. -->
      <MobileNav
        client:load
        items={navItems}
        locale={locale}
        labels={{
          navAria: t('nav.aria'),
          openMenu: t('nav.openMenu'),
          closeMenu: t('nav.closeMenu'),
          language: t('nav.language'),
          cta: t('buttons.startConversation'),
          home: t('nav.home'),
        }}
      >
        <Logo slot="logo" class="h-7 w-7" />
      </MobileNav>
    </div>
  </div>

  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress-fill" data-progress></div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------
     Two states, and nothing in the bar moves horizontally between them. At
     the top of the page it is a 4.5rem row; past the fold it collapses to a
     strip flush with the top edge that shrinks the mark and trades the empty
     space for a depth readout plus a hairline of scroll progress.

     Navigation belongs to neither state — it is behind the menu button at
     every width — so the bar has no expand-on-hover behaviour and no third
     state to get stuck in.

     Astro's scoped styles are unlayered, so these beat Tailwind's utilities
     (h-16 / md:h-[4.5rem]) on the same elements without !important.
     -------------------------------------------------------------------- */
  #site-header {
    transition: border-color 0.3s ease;
  }
  #site-header.is-strip {
    border-color: var(--c-line);
  }
  .header-backdrop {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #site-header.is-strip .header-backdrop {
    opacity: 1;
    background-color: color-mix(in srgb, var(--c-paper) 92%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .header-bar {
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* 3.25rem rather than the tighter strip this used to be: the menu button is
     2.5rem tall on its own and now rides in the strip at every width, so a
     2.5rem bar would leave it no clearance at all. */
  #site-header.is-strip .header-bar {
    height: 3.25rem;
  }

  /* Logo.astro sizes only the mark from its class prop; the wordmark beside it
     is a separate span, so scale both from the anchor. */
  .header-logo :global(svg),
  .header-logo :global(.display) {
    transition:
      height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      font-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #site-header.is-strip .header-logo :global(svg) {
    height: 1.25rem;
    width: 1.25rem;
  }
  #site-header.is-strip .header-logo :global(.display) {
    font-size: 0.9rem;
  }
  /* On narrow screens the wordmark and the readout can't both fit — the mark
     alone carries the branding once you've scrolled, and the readout is the
     thing doing work here. */
  @media (max-width: 639.98px) {
    #site-header.is-strip .header-logo :global(.display) {
      display: none;
    }
  }

  /* The menu panel opens inside #site-header, so the strip state reaches into
     it: the panel's own logo row tracks the bar's height and the mark stays
     where it was when the panel covers the bar. :global because the class
     belongs to the React island. */
  #site-header.is-strip :global(.menu-logo-row) {
    height: 3.25rem;
  }

  /* Collapses its width as well as fading, so it claims no space at the top of
     the page where the wordmark is at full size. */
  .section-readout {
    transition:
      opacity 0.25s ease,
      visibility 0.25s,
      max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding-inline-start 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
    max-width: 0;
    overflow: hidden;
    padding-inline-start: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.72rem;
    color: var(--c-ink-2);
    opacity: 0;
    visibility: hidden;
  }
  #site-header.is-strip .section-readout {
    opacity: 1;
    visibility: visible;
    max-width: 32rem;
    padding-inline-start: 1.25rem;
  }
  .readout-index {
    color: var(--c-accent);
  }
  .readout-index:not(:empty)::after {
    content: '\00a0—\00a0';
    color: var(--c-ink-3);
  }

  /* Full-bleed hairline of scroll progress along the bar's bottom edge. */
  .scroll-progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  #site-header.is-strip .scroll-progress {
    opacity: 1;
  }
  .scroll-progress-fill {
    height: 100%;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* :global on the ancestor is required — Astro otherwise scopes the [dir]
     compound too, producing [data-astro-cid-…][dir='rtl'], which can never
     match because <html> doesn't carry this component's scope attribute. */
  :global([dir='rtl']) .scroll-progress-fill {
    transform-origin: right;
  }

  .locale-toggle:hover + .locale-dropdown,
  .locale-dropdown:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(2px);
  }
  .locale-dropdown {
    transform: translateY(0);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
  }
  .locale-toggle:focus-visible + .locale-dropdown {
    opacity: 1;
    visibility: visible;
  }

  /* MobileNav sets data-menu-open on <html> for as long as its panel is up.
     The header is fixed to the viewport, so the body's gutter padding doesn't
     reach it — without this its controls slide outward by the scrollbar's
     width the moment the menu locks scrolling. Nothing else needs pinning:
     the bar has no hover or focus state left to expand into. */
  :global(html[data-menu-open]) #site-header {
    padding-inline-end: var(--menu-gutter, 0px);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    .header-backdrop,
    .header-bar,
    .header-logo :global(svg),
    .header-logo :global(.display),
    .section-readout,
    .scroll-progress,
    .locale-dropdown {
      transition: none !important;
    }
  }
</style>

<style is:global>
  /* --------------------------------------------------------------------
     Menu motion.

     Global rather than scoped because every element below is rendered by
     MobileNav, a React island: Astro stamps its scope attribute onto markup
     in .astro templates only, so a scoped selector here could never match.

     The panel's own open/close state is the one piece of this that isn't
     pure CSS — MobileNav keeps the element mounted for the length of the
     exit wipe (its EXIT_MS) and swaps .is-open for .is-closing.
     -------------------------------------------------------------------- */

  /* Hamburger ⇄ close. Both strokes are always present; each rotates about
     its own midpoint and slides to the icon's centre line, so the two meet
     as an X. scaleX comes after rotate so it shortens the bar along its own
     axis rather than shearing the angle. */
  .menu-icon-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-icon-bar:nth-child(2) {
    transition-delay: 0.05s;
  }
  .menu-toggle[data-open] .menu-icon-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg) scaleX(0.72);
  }
  .menu-toggle[data-open] .menu-icon-bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg) scaleX(0.72);
  }

  /* The panel wipes down over the page and back up off it — clip-path rather
     than a transform so the content stays put while it's uncovered, which
     keeps the panel's mark on the exact spot the header's mark occupies. */
  .menu-panel {
    animation: menu-panel-in 0.52s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .menu-panel.is-closing {
    animation: menu-panel-out 0.28s cubic-bezier(0.7, 0, 0.84, 0) both;
  }
  @keyframes menu-panel-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes menu-panel-out {
    from {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    to {
      clip-path: inset(0 0 100% 0);
      opacity: 0.35;
    }
  }

  /* Rows rise into place just behind the wipe's leading edge, one after
     another. The panel's logo row is deliberately not in here: it sits on the
     exact coordinates of the header's own mark, so leaving it still means the
     curtain covers one mark and uncovers an identical one on the same frame
     and the mark reads as having never moved. */
  .menu-panel .menu-stagger {
    animation: menu-row-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.16s + var(--i, 0) * 0.05s);
  }
  /* On the way out the rows don't leave individually — the wipe takes the
     whole panel, and cancelling their animations drops them at their resting
     state instead of replaying the entrance under the closing edge. */
  .menu-panel.is-closing .menu-stagger {
    animation: none;
  }
  @keyframes menu-row-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Hover on a row nudges its label off the rule and warms its index. */
  .menu-label {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-index {
    transition: color 0.25s ease;
  }
  .menu-row:hover .menu-label {
    transform: translateX(0.35rem);
  }
  [dir='rtl'] .menu-row:hover .menu-label {
    transform: translateX(-0.35rem);
  }
  .menu-row:hover .menu-index {
    color: var(--c-accent);
  }

  /* Accordion. grid-template-rows 0fr → 1fr is the one way to transition to a
     content-derived height without measuring it in JS; the inner element does
     the clipping, because the row itself can't hide its own overflow. */
  .menu-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-sub[data-expanded] {
    grid-template-rows: 1fr;
  }
  .menu-sub-clip {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-0.4rem);
    transition:
      opacity 0.3s ease,
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-sub[data-expanded] .menu-sub-clip {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon-bar,
    .menu-panel,
    .menu-panel .menu-stagger,
    .menu-chevron,
    .menu-label,
    .menu-index,
    .menu-sub,
    .menu-sub-clip {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const readoutIndex = document.querySelector<HTMLElement>('[data-readout-index]');
  const readoutLabel = document.querySelector<HTMLElement>('[data-readout-label]');

  /* -------------------------------------------------------------------
     Full bar ⇄ depth strip. Separate enter/exit thresholds so the bar can't
     flap around a single boundary.
     ------------------------------------------------------------------- */
  const STRIP_ENTER = 72;
  const STRIP_EXIT = 24;
  let isStrip = false;
  let frame = 0;

  function onScroll() {
    frame = 0;
    if (!header) return;

    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    }

    const y = window.scrollY;
    if (!isStrip && y > STRIP_ENTER) {
      isStrip = true;
      header.classList.add('is-strip');
    } else if (isStrip && y < STRIP_EXIT) {
      isStrip = false;
      header.classList.remove('is-strip');
    }
  }

  onScroll();
  window.addEventListener(
    'scroll',
    () => {
      if (!frame) frame = requestAnimationFrame(onScroll);
    },
    { passive: true }
  );

  /* Depth readout. Sections are found by the marker SectionHeading.astro
     emits rather than by `section[id]` — most inner-page sections carry no
     id. A zero-height root at the viewport centre means exactly one section
     is ever intersecting. Deliberately IntersectionObserver rather than
     ScrollTrigger: this must keep working under prefers-reduced-motion,
     where initMotion() bails out and Lenis never starts. */
  if (readoutIndex && readoutLabel) {
    // Every section is observed, not just the labelled ones — sections without
    // a SectionHeading (the hero, Mission) must blank the readout rather than
    // leave the previous section's label standing.
    const sections = Array.from(document.querySelectorAll<HTMLElement>('#main > section'));

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const marker = entry.target.querySelector<HTMLElement>('[data-section-label]');
            readoutIndex.textContent = marker?.dataset.sectionIndex ?? '';
            readoutLabel.textContent = marker?.dataset.sectionLabel ?? '';
          }
        },
        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
    }
  }
</script>
