---
import Logo from './Logo.astro';
import ThemeToggle from './islands/ThemeToggle';
import MobileNav from './islands/MobileNav';
import { useTranslations } from '../i18n/useTranslations';
import { localeNames, locales } from '../i18n/config';
import type { Locale } from '../i18n/config';

const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);
const navItems = tRaw<{ label: string; href: string; items?: { label: string; href: string; items?: { label: string; href: string; description?: string }[] }[] }[]>('nav.items');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent"
  data-active=""
>
  <div class="container-x flex h-16 items-center justify-between gap-6 md:h-[4.5rem]">
    <a href="/" class="text-ink" aria-label="Substrate — home">
      <Logo class="h-7 w-7" />
    </a>

    <nav class="hidden md:block" aria-label={t('nav.aria')} data-nav>
      <ul class="flex items-center gap-0">
        {navItems.map((item, i) => (
          <li data-trigger={i}>
            <a
              href={item.href}
              class="nav-link relative flex items-center gap-1 px-3.5 py-2 text-[0.9rem] font-medium text-ink-2 transition-colors hover:text-ink"
            >
              {item.label}
              {item.items && (
                <svg class="h-3 w-3 transition-transform duration-200" data-chevron viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      <!-- Locale switcher -->
      <div class="hidden md:relative md:block">
        <button
          type="button"
          class="locale-toggle inline-flex h-9 w-9 items-center justify-center rounded-full text-xs font-mono font-medium text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink"
          aria-label={t('nav.switchLocale')}
        >
          {locale.toUpperCase()}
        </button>
        <div class="locale-dropdown absolute right-0 top-full mt-1 min-w-[9rem] rounded-lg border border-line bg-paper py-1.5 shadow-lg shadow-black/5 opacity-0 invisible transition-all duration-200">
          {locales.map((l) => (
            <a
              href={l === 'en' ? '/' : `/${l}/`}
              class={`block px-4 py-1.5 text-sm transition-colors hover:text-accent ${l === locale ? 'font-semibold text-accent' : 'text-ink-2'}`}
              hreflang={l}
            >
              {localeNames[l]}
            </a>
          ))}
        </div>
      </div>

      <ThemeToggle client:load />
      <a
        href="/contact"
        class="hidden rounded-full border border-line-2 px-4.5 py-2 text-sm font-medium text-ink transition-colors hover:border-ink-2 hover:bg-paper-2 md:inline-flex"
      >
        {t('buttons.startConversation')}
      </a>
      <MobileNav client:load items={navItems} locale={locale} />
    </div>
  </div>

  <!-- Full-screen mega overlay -->
  <div class="mega-overlay hidden" data-overlay aria-hidden="true">
    <div class="container-x mx-auto pt-8 pb-14">
      {navItems.map((item, i) =>
        item.items ? (
          <div class="mega-panel hidden" data-panel={i}>
            <div class="grid grid-cols-4 gap-x-10 gap-y-10">
              {item.items.map((col) => (
                <div>
                  {col.items ? (
                    <>
                      <a href={col.href} class="mega-overlay-heading">{col.label}</a>
                      {col.items.map((sub) => (
                        <a href={sub.href} class="mega-overlay-link">
                          {sub.label}
                          {sub.description && (
                            <span class="mega-overlay-desc">{sub.description}</span>
                          )}
                        </a>
                      ))}
                    </>
                  ) : (
                    <a href={col.href} class="mega-overlay-heading">{col.label}</a>
                  )}
                </div>
              ))}
            </div>
          </div>
        ) : null
      )}
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-line" aria-hidden="true" />
  </div>
</header>

<style>
  #site-header {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  #site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--c-paper) 84%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-color: var(--c-line);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline-start: 0.875rem;
    bottom: 0;
    height: 1.5px;
    width: calc(100% - 1.75rem);
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .mega-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.08);
    transform: translateY(-16px);
    opacity: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    will-change: transform, opacity;
  }
  .mega-overlay.open {
    transform: translateY(0);
    opacity: 1;
  }

  .mega-overlay-heading {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 640;
    color: var(--c-ink);
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
  }
  .mega-overlay-heading:hover {
    color: var(--c-accent);
  }

  .mega-overlay-link {
    display: block;
    font-size: 0.88rem;
    color: var(--c-ink-2);
    padding: 0.35rem 0;
    transition: color 0.2s ease;
    line-height: 1.4;
  }
  .mega-overlay-link:hover {
    color: var(--c-accent);
  }

  .mega-overlay-desc {
    display: block;
    font-size: 0.78rem;
    color: var(--c-ink-3);
    line-height: 1.3;
    margin-top: 0.1rem;
  }

  .locale-toggle:hover + .locale-dropdown,
  .locale-dropdown:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(2px);
  }
  .locale-dropdown {
    transform: translateY(0);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
  }
  .locale-toggle:focus-visible + .locale-dropdown {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    .nav-link::after,
    .mega-overlay,
    .locale-dropdown {
      transition: none !important;
    }
    .mega-overlay {
      transform: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const updateIsScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  updateIsScrolled();
  window.addEventListener('scroll', updateIsScrolled, { passive: true });

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const overlay = document.querySelector<HTMLElement>('[data-overlay]');
  const triggers = document.querySelectorAll<HTMLElement>('[data-trigger]');
  const isHover = window.matchMedia('(hover: hover)').matches;

  if (nav && overlay) {
    let activeIdx: number | null = null;
    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    const CLOSE_DELAY = 250;

    function getPanel(idx: number): HTMLElement | null {
      return overlay.querySelector(`[data-panel="${idx}"]`);
    }

    function openPanel(idx: number) {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      if (activeIdx === idx && overlay.classList.contains('open')) return;

      if (activeIdx !== null) {
        const prev = getPanel(activeIdx);
        prev?.classList.add('hidden');
      }

      activeIdx = idx;
      const panel = getPanel(idx);
      if (panel) {
        panel.classList.remove('hidden');
        overlay.classList.remove('hidden');
        overlay.offsetHeight; // force reflow
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function scheduleClose() {
      if (closeTimer) return;
      closeTimer = setTimeout(() => {
        closeTimer = null;
        overlay.classList.remove('open');
        if (activeIdx !== null) {
          const panel = getPanel(activeIdx);
          panel?.classList.add('hidden');
        }
        activeIdx = null;
        document.body.style.overflow = '';
        setTimeout(() => overlay.classList.add('hidden'), 300);
      }, CLOSE_DELAY);
    }

    function cancelClose() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    triggers.forEach((trigger, idx) => {
      const link = trigger.querySelector<HTMLAnchorElement>('a');
      if (!link || !getPanel(idx)) return;

      // Hover behaviour
      if (isHover) {
        trigger.addEventListener('mouseenter', () => openPanel(idx));
        trigger.addEventListener('mouseleave', scheduleClose);
      }

      // Click navigates normally; for touch devices, toggle instead
      link.addEventListener('click', (e) => {
        if (isHover) return; // navigate naturally
        e.preventDefault();
        if (overlay.classList.contains('open') && activeIdx === idx) {
          scheduleClose();
        } else {
          openPanel(idx);
        }
      });

      trigger.addEventListener('focusin', () => {
        if (!overlay.classList.contains('open')) {
          openPanel(idx);
        }
      });
    });

    // Keep overlay open while hovering over it
    if (isHover) {
      overlay.addEventListener('mouseenter', cancelClose);
      overlay.addEventListener('mouseleave', scheduleClose);
    }

    document.addEventListener('focusin', (e) => {
      if (overlay.classList.contains('open') && !header!.contains(e.target as Node)) {
        cancelClose();
        overlay.classList.remove('open');
        if (activeIdx !== null) {
          const panel = getPanel(activeIdx);
          panel?.classList.add('hidden');
        }
        activeIdx = null;
        document.body.style.overflow = '';
        setTimeout(() => overlay.classList.add('hidden'), 300);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('open')) {
        const lastIdx = activeIdx;
        cancelClose();
        overlay.classList.remove('open');
        if (activeIdx !== null) {
          const panel = getPanel(activeIdx);
          panel?.classList.add('hidden');
        }
        activeIdx = null;
        document.body.style.overflow = '';
        setTimeout(() => overlay.classList.add('hidden'), 300);
        if (lastIdx !== null) {
          const link = triggers[lastIdx]?.querySelector<HTMLAnchorElement>('a');
          link?.focus();
        }
      }
    });
  }
</script>
