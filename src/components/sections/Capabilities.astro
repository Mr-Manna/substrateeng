---
import SectionHeading from '../SectionHeading.astro';
import { capabilities } from '../../data/capabilities';

// 24×24 line glyphs, one per discipline — drawn, not imported
const glyphs: Record<string, string> = {
  enterprise: `<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="3.5" width="7" height="7" rx="1"/><rect x="3.5" y="13.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.15"/>`,
  cloud: `<path d="M12 3.5l8 4-8 4-8-4 8-4Z"/><path d="M4 13l8 4 8-4"/><path d="M4 17l8 4 8-4"/>`,
  platform: `<rect x="3.5" y="15.5" width="17" height="4.5" rx="1"/><path d="M7.5 15.5v-5M12 15.5V4.5M16.5 15.5V8"/>`,
  automation: `<path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 3.5V8h-4.5"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>`,
  ai: `<path d="M12 3.5c.6 4.6 3.3 7.3 7.9 7.9-4.6.6-7.3 3.3-7.9 7.9-.6-4.6-3.3-7.3-7.9-7.9 4.6-.6 7.3-3.3 7.9-7.9Z"/>`,
  agentic: `<circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="8" r="2.4"/><circle cx="10" cy="18" r="2.4"/><path d="M8.4 6.4l7.2 1.2M6.8 8.2l2.5 7.5M16.6 10L11.6 16"/>`,
  data: `<ellipse cx="12" cy="6" rx="7.5" ry="2.8"/><path d="M4.5 6v12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V6"/><path d="M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>`,
  performance: `<path d="M4 20v-6M9.3 20V9M14.6 20v-8M20 20V4.5"/>`,
  sre: `<path d="M3 12.5h4l2.5-6.5 4.5 12 2.5-5.5H21"/>`,
};
---

<section id="capabilities" class="bg-paper-2 py-24 md:py-36" aria-labelledby="capabilities-heading">
  <div class="container-x">
    <SectionHeading
      id="capabilities-heading"
      index="02"
      label="Core Capabilities"
      title="Nine disciplines. One engineering culture."
      lede="Deep specialisms that compound: the same teams who architect your cloud foundations build the platforms, pipelines, and AI systems that run on them."
    />

    <ul
      class="mt-14 grid overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
      style="gap: 1px;"
      data-reveal-group
    >
      {
        capabilities.map((cap, i) => (
          <li class="group relative bg-paper p-7 transition-colors duration-300" data-reveal>
            <span
              class="absolute top-0 left-0 h-[2px] w-0 bg-accent transition-[width] duration-300 ease-out group-hover:w-full motion-reduce:transition-none"
              aria-hidden="true"
            />
            <div class="flex items-center justify-between">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6 text-ink-3 transition-colors duration-300 group-hover:text-accent"
                aria-hidden="true"
                set:html={glyphs[cap.glyph]}
              />
              <span class="font-mono text-xs text-ink-3">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-6 font-display text-[1.05rem] font-semibold text-ink">{cap.title}</h3>
            <p class="mt-2.5 text-[0.92rem] leading-relaxed text-ink-2">{cap.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
