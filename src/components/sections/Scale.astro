---
import SectionHeading from '../SectionHeading.astro';
import { useTranslations } from '../../i18n/useTranslations';
import type { Locale } from '../../i18n/config';

const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);
const svgLabels = tRaw<string[]>('scale.svgLabels');
---

<section id="scale" class="py-24 md:py-36" aria-labelledby="scale-heading">
  <div class="container-x">
    <SectionHeading
      id="scale-heading"
      index={t('scale.index')}
      label={t('scale.label')}
      title={t('scale.title')}
      lede={t('scale.lede')}
    />

    <div class="mt-14 grid gap-10 md:grid-cols-3" data-reveal-group>
      {
        [0, 1, 2].map((i) => (
          <div class="border-t border-line pt-5" data-reveal>
            <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-lg font-semibold text-ink">{t('scale.points.' + i + '.title')}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-2">{t('scale.points.' + i + '.body')}</p>
          </div>
        ))
      }
    </div>

    <!-- Blueprint: a reference platform, drawn as you scroll -->
    <figure class="mt-16 overflow-x-auto md:mt-20" data-scale-diagram>
      <svg
        viewBox="0 0 1160 330"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-labelledby="scale-diagram-title"
        class="min-w-[860px]"
      >
        <title id="scale-diagram-title">
          {t('scale.svgTitle')}
        </title>

        <!-- clients -->
        <g data-node>
          <rect x="20" y="96" width="56" height="40" rx="4" stroke="var(--c-ink-3)" stroke-width="1.1"></rect>
          <rect x="34" y="150" width="28" height="46" rx="4" stroke="var(--c-ink-3)" stroke-width="1.1"></rect>
          <text x="48" y="226" text-anchor="middle" class="bp-label">{svgLabels[0]}</text>
        </g>

        <!-- edge -->
        <g data-node>
          <rect x="170" y="112" width="104" height="64" rx="5" stroke="var(--c-ink)" stroke-width="1.2"></rect>
          <path d="M198 132 h48 M198 144 h48 M198 156 h30" stroke="var(--c-ink-3)" stroke-width="1"></path>
          <text x="222" y="200" text-anchor="middle" class="bp-label">{svgLabels[1]}</text>
        </g>

        <!-- service mesh -->
        <g data-node>
          <rect x="356" y="64" width="196" height="160" rx="6" stroke="var(--c-line-2)" stroke-width="1" stroke-dasharray="4 4"></rect>
          {
            [0, 1, 2].map((col) =>
              [0, 1].map((row) => (
                <rect
                  x={376 + col * 56}
                  y={92 + row * 56}
                  width="40"
                  height="40"
                  rx="4"
                  stroke="var(--c-ink)"
                  stroke-width="1.1"
                ></rect>
              ))
            )
          }
          <circle cx="396" cy="112" r="2" fill="var(--c-accent)"></circle>
          <circle cx="452" cy="168" r="2" fill="var(--c-accent)"></circle>
          <circle cx="508" cy="112" r="2" fill="var(--c-accent)"></circle>
          <text x="454" y="248" text-anchor="middle" class="bp-label">{svgLabels[2]}</text>
        </g>

        <!-- event stream -->
        <g data-node>
          <rect x="632" y="118" width="130" height="52" rx="26" stroke="var(--c-ink)" stroke-width="1.2"></rect>
          <path d="M656 144 h20 m8 0 h20 m8 0 h20" stroke="var(--c-accent)" stroke-width="1.4" stroke-linecap="round"></path>
          <text x="697" y="200" text-anchor="middle" class="bp-label">{svgLabels[3]}</text>
        </g>

        <!-- data platform -->
        <g data-node>
          <ellipse cx="878" cy="106" rx="34" ry="11" stroke="var(--c-ink)" stroke-width="1.1"></ellipse>
          <path d="M844 106 v52 a34 11 0 0 0 68 0 v-52" stroke="var(--c-ink)" stroke-width="1.1"></path>
          <path d="M844 132 a34 11 0 0 0 68 0" stroke="var(--c-ink-3)" stroke-width="1"></path>
          <text x="878" y="200" text-anchor="middle" class="bp-label">{svgLabels[4]}</text>
        </g>

        <!-- intelligence -->
        <g data-node>
          <circle cx="1064" cy="144" r="30" stroke="var(--c-accent)" stroke-width="1.3"></circle>
          <circle cx="1064" cy="144" r="4" fill="var(--c-accent)"></circle>
          <path
            d="M1064 114 v-14 M1064 174 v14 M1034 144 h-14 M1094 144 h14 M1043 123 l-10 -10 M1085 123 l10 -10 M1043 165 l-10 10 M1085 165 l10 10"
            stroke="var(--c-accent)" stroke-width="1" opacity="0.6"
          ></path>
          <text x="1064" y="226" text-anchor="middle" class="bp-label">{svgLabels[5]}</text>
        </g>

        <!-- flow paths, drawn on scroll -->
        <path data-draw d="M76 122 C 120 122, 128 144, 170 144" stroke="var(--c-accent)" stroke-width="1.4"></path>
        <path data-draw d="M274 144 H 356" stroke="var(--c-accent)" stroke-width="1.4"></path>
        <path data-draw d="M552 144 H 632" stroke="var(--c-accent)" stroke-width="1.4"></path>
        <path data-draw d="M762 144 C 800 144, 806 132, 844 132" stroke="var(--c-accent)" stroke-width="1.4"></path>
        <path data-draw d="M912 132 C 960 132, 986 144, 1034 144" stroke="var(--c-accent)" stroke-width="1.4"></path>
      </svg>
      <figcaption class="mt-4 font-mono text-xs tracking-[0.12em] text-ink-3">
        {t('scale.figcaption')}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .bp-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  if (!prefersReducedMotion()) {
    const diagram = document.querySelector('[data-scale-diagram]');
    if (diagram) {
      const paths = gsap.utils.toArray<SVGPathElement>('[data-scale-diagram] [data-draw]');
      paths.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: diagram, start: 'top 78%', end: 'top 30%', scrub: 1 },
      });
      tl.from('[data-scale-diagram] [data-node]', {
        opacity: 0,
        y: 14,
        stagger: 0.12,
        duration: 0.5,
      });
      tl.to(paths, { strokeDashoffset: 0, stagger: 0.14, duration: 0.6 }, 0.15);
    }
  }
</script>
