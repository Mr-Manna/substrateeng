---
import SectionHeading from '../SectionHeading.astro';
import { techGroups } from '../../data/technology';

/*
 * Graphite band — always dark in both themes, a descent below the surface
 * of the page. Colors here use graphite-* and accent-bright directly.
 */
---

<section id="technology" class="bg-graphite py-24 md:py-36" aria-labelledby="technology-heading">
  <div class="container-x">
    <SectionHeading
      id="technology-heading"
      tone="graphite"
      index="04"
      label="Technology"
      title="Boring where it should be. Sharp where it counts."
      lede="We are opinionated about tools and unsentimental about brands. A technology earns its place here by being automatable, observable, and still maintained ten years from now."
    />

    <!-- Pipeline: every merge walks this path, pulses flowing continuously -->
    <figure class="mt-16 overflow-x-auto md:mt-20" data-reveal data-tech-pipeline>
      <svg
        viewBox="0 0 1160 200"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-labelledby="tech-pipeline-title"
        class="min-w-[900px]"
      >
        <title id="tech-pipeline-title">
          Delivery pipeline: commit, build, test, scan, stage, canary, production — with an
          automated rollback path from production back to staging.
        </title>

        <!-- COMMIT -->
        <g data-node>
          <rect x="20" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <circle cx="55" cy="91" r="4" stroke="var(--c-graphite-fg)" stroke-width="1.2"></circle>
          <path d="M59 91 H91" stroke="var(--c-graphite-fg)" stroke-width="1.2"></path>
          <circle cx="95" cy="91" r="4" stroke="var(--c-graphite-fg)" stroke-width="1.2"></circle>
          <text x="75" y="146" text-anchor="middle" class="pl-label">COMMIT</text>
        </g>

        <!-- BUILD -->
        <g data-node>
          <rect x="190" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <path d="M245 76 l14 7 v14 l-14 7 -14 -7 v-14 Z M231 83 l14 7 14 -7 M245 90 v14" stroke="var(--c-graphite-fg)" stroke-width="1.1" stroke-linejoin="round"></path>
          <text x="245" y="146" text-anchor="middle" class="pl-label">BUILD</text>
        </g>

        <!-- TEST -->
        <g data-node>
          <rect x="360" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <circle cx="415" cy="91" r="12" stroke="var(--c-graphite-fg)" stroke-width="1.1"></circle>
          <path data-draw d="M409 91 l4 5 8 -9" stroke="var(--c-accent-bright)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="415" y="146" text-anchor="middle" class="pl-label">TEST</text>
        </g>

        <!-- SCAN -->
        <g data-node>
          <rect x="530" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <path d="M585 76 l11 5 v9 c0 7 -5 11 -11 14 c-6 -3 -11 -7 -11 -14 v-9 Z" stroke="var(--c-graphite-fg)" stroke-width="1.1" stroke-linejoin="round"></path>
          <path data-draw d="M580 91 l3.5 4 7 -8" stroke="var(--c-accent-bright)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="585" y="146" text-anchor="middle" class="pl-label">SCAN</text>
        </g>

        <!-- STAGE -->
        <g data-node>
          <rect x="700" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <path d="M755 78 l12 6 -12 6 -12 -6 Z M743 94 l12 6 12 -6 M743 100 l12 6 12 -6" stroke="var(--c-graphite-fg)" stroke-width="1.1" stroke-linejoin="round"></path>
          <text x="755" y="146" text-anchor="middle" class="pl-label">STAGE</text>
        </g>

        <!-- CANARY -->
        <g data-node>
          <rect x="870" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-graphite-fg-2)" stroke-width="1.1"></rect>
          <path d="M913 98 a12 12 0 0 1 24 0" stroke="var(--c-graphite-fg)" stroke-width="1.1"></path>
          <path data-draw d="M925 98 l7 -8" stroke="var(--c-accent-bright)" stroke-width="1.3" stroke-linecap="round"></path>
          <text x="925" y="146" text-anchor="middle" class="pl-label">CANARY 5%</text>
        </g>

        <!-- PROD -->
        <g data-node>
          <rect x="1040" y="64" width="110" height="54" rx="6" fill="var(--c-graphite-2)" stroke="var(--c-accent-bright)" stroke-width="1.2"></rect>
          <circle cx="1095" cy="91" r="5" fill="var(--c-accent-bright)"></circle>
          <circle data-prod-ring cx="1095" cy="91" r="10" stroke="var(--c-accent-bright)" stroke-width="1"></circle>
          <text x="1095" y="146" text-anchor="middle" class="pl-label pl-label-accent">PROD</text>
        </g>

        <!-- connectors + cumulative clock -->
        <path data-draw d="M130 91 H190" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-draw d="M300 91 H360" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-draw d="M470 91 H530" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-draw d="M640 91 H700" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-draw d="M810 91 H870" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-draw d="M980 91 H1040" stroke="var(--c-graphite-line)" stroke-width="1.2"></path>
        <path data-flow d="M130 91 H190" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <path data-flow d="M300 91 H360" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <path data-flow d="M470 91 H530" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <path data-flow d="M640 91 H700" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <path data-flow d="M810 91 H870" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <path data-flow d="M980 91 H1040" stroke="var(--c-accent-bright)" stroke-width="1.6" stroke-linecap="round"></path>
        <text x="160" y="82" text-anchor="middle" class="pl-time">T+90S</text>
        <text x="330" y="82" text-anchor="middle" class="pl-time">T+5M</text>
        <text x="500" y="82" text-anchor="middle" class="pl-time">T+14M</text>
        <text x="670" y="82" text-anchor="middle" class="pl-time">T+16M</text>
        <text x="840" y="82" text-anchor="middle" class="pl-time">T+31M</text>
        <text x="1010" y="82" text-anchor="middle" class="pl-time">T+45M</text>

        <!-- rollback: rare, automated, drawn anyway -->
        <path d="M1095 118 C 1080 172, 770 172, 755 118" stroke="var(--c-graphite-fg-2)" stroke-width="1" stroke-dasharray="4 5" opacity="0.45"></path>
        <text x="925" y="176" text-anchor="middle" class="pl-time">AUTOMATED ROLLBACK — IF EVER</text>
      </svg>
      <figcaption class="mt-4 font-mono text-xs tracking-[0.12em] text-graphite-fg-2">
        FIG. 04 — PATH TO PRODUCTION. EVERY MERGE, EVERY SERVICE, EVERY DAY.
      </figcaption>
    </figure>

    <!-- Bill of materials -->
    <div class="mt-16 grid gap-x-8 gap-y-10 sm:grid-cols-2 md:mt-20 lg:grid-cols-5" data-reveal-group>
      {
        techGroups.map((group) => (
          <div class="border-t border-graphite-line pt-5" data-reveal>
            <h3 class="kicker text-graphite-fg">{group.name}</h3>
            <p class="mt-2 text-[0.85rem] text-graphite-fg-2 italic">{group.note}</p>
            <ul class="mt-4 space-y-1.5">
              {group.items.map((item) => (
                <li class="flex items-center gap-2.5 font-mono text-[0.85rem] text-graphite-fg">
                  <span class="h-1 w-1 shrink-0 rounded-full bg-accent-bright opacity-70" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pl-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-graphite-fg-2);
  }
  .pl-label-accent {
    fill: var(--c-accent-bright);
  }
  .pl-time {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    fill: var(--c-graphite-fg-2);
    opacity: 0.75;
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  if (!prefersReducedMotion()) {
    const pipeline = document.querySelector('[data-tech-pipeline]');
    if (pipeline) {
      const draws = gsap.utils.toArray<SVGPathElement>('[data-tech-pipeline] [data-draw]');
      draws.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

      ScrollTrigger.create({
        trigger: pipeline,
        start: 'top 75%',
        once: true,
        onEnter: () => {
          const tl = gsap.timeline();
          tl.from('[data-tech-pipeline] [data-node]', {
            opacity: 0,
            y: 12,
            duration: 0.5,
            stagger: 0.1,
            ease: 'power2.out',
          });
          tl.to(
            draws,
            {
              strokeDashoffset: 0,
              duration: 0.5,
              stagger: 0.08,
              ease: 'power1.inOut',
              onComplete: () => draws.forEach((p) => (p.style.strokeDasharray = 'none')),
            },
            0.3
          );

          // merges keep flowing through the pipeline
          tl.add(() => {
            pipeline.querySelectorAll<SVGPathElement>('[data-flow]').forEach((p, i) => {
              const len = p.getTotalLength();
              const period = len + 12;
              gsap.set(p, { strokeDasharray: `12 ${len}`, strokeDashoffset: 12, opacity: 1 });
              gsap.to(p, {
                strokeDashoffset: 12 - period,
                duration: 1.4,
                ease: 'none',
                repeat: -1,
                delay: i * 0.2,
              });
            });
            gsap.fromTo(
              '[data-prod-ring]',
              { attr: { r: 6 }, opacity: 0.9 },
              { attr: { r: 15 }, opacity: 0, duration: 1.8, ease: 'power1.out', repeat: -1 }
            );
          });
        },
      });

      // flows stay invisible until the intro timeline starts them
      pipeline.querySelectorAll<SVGPathElement>('[data-flow]').forEach((p) => {
        p.style.opacity = '0';
      });
    }
  }
</script>
