---
import Button from '../Button.astro';
import { useTranslations } from '../../i18n/useTranslations';
import type { Locale } from '../../i18n/config';

const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);
const trusted = tRaw<string[]>('hero.trustedClients');
const stratum = tRaw<Record<string, string>>('hero.stratumLabels');
const strataLabels = [stratum.experience, stratum.services, stratum.data, stratum.substrate];
---

<section class="hero relative overflow-hidden pt-36 pb-20 md:pt-44 md:pb-24">
  <div class="container-x relative">
    <div class="grid items-center gap-14 lg:grid-cols-[7fr_5fr] lg:gap-10">
      <div>
        <p class="kicker text-ink-3" data-hero-item>
          {t('hero.kickerPrefix')} <span class="normal-case tracking-normal">{t('hero.kickerPronounciation')}</span>
          <span aria-hidden="true">&nbsp;&mdash;&nbsp;</span>{t('hero.kickerSuffix')}
        </p>
        <h1
          class="display mt-7 text-[2.9rem] leading-[1.02] text-ink sm:text-6xl lg:text-[4.6rem]"
          data-hero-item
        >
          {t('hero.title')}
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-2" data-hero-item>
          {t('hero.subtitle')}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4" data-hero-item>
          <Button href="/contact">{t('hero.ctaPrimary')}</Button>
          <Button href="/#capabilities" variant="secondary">{t('hero.ctaSecondary')}</Button>
        </div>
      </div>

      <!-- Signature: the substrate — four strata of a modern platform -->
      <figure class="mx-auto w-full max-w-[26rem] lg:max-w-none" data-hero-item>
        <svg
          viewBox="-30 0 490 420"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-labelledby="hero-strata-title"
          class="w-full"
        >
          <title id="hero-strata-title">
            {t('hero.svgTitle')}
          </title>

          <!-- Layer: Experience -->
          <g data-layer>
            <path
              d="M250 8 L390 64 L250 120 L110 64 Z"
              fill="var(--c-paper)" stroke="var(--c-ink-3)" stroke-width="1.1"
              data-draw pathLength="1"
            ></path>
            <circle cx="250" cy="42" r="2.2" fill="var(--c-ink-3)"></circle>
            <circle cx="300" cy="64" r="2.2" fill="var(--c-ink-3)"></circle>
            <circle cx="200" cy="64" r="2.2" fill="var(--c-ink-3)"></circle>
            <line x1="110" y1="64" x2="64" y2="64" stroke="var(--c-line-2)" stroke-width="1" data-draw pathLength="1"></line>
            <text x="58" y="67" text-anchor="end" class="stratum-label">{strataLabels[0]}</text>
          </g>

          <!-- Layer: Services -->
          <g data-layer>
            <path
              d="M250 88 L390 144 L250 200 L110 144 Z"
              fill="var(--c-paper)" stroke="var(--c-ink-3)" stroke-width="1.1"
              data-draw pathLength="1"
            ></path>
            <path d="M250 128 l22 8.8 -22 8.8 -22 -8.8 Z" fill="none" stroke="var(--c-ink-3)" stroke-width="1" data-draw pathLength="1"></path>
            <path d="M292 145 l14 5.6 -14 5.6 -14 -5.6 Z" fill="none" stroke="var(--c-ink-3)" stroke-width="1" data-draw pathLength="1"></path>
            <path d="M208 145 l14 5.6 -14 5.6 -14 -5.6 Z" fill="none" stroke="var(--c-ink-3)" stroke-width="1" data-draw pathLength="1"></path>
            <line x1="110" y1="144" x2="64" y2="144" stroke="var(--c-line-2)" stroke-width="1" data-draw pathLength="1"></line>
            <text x="58" y="147" text-anchor="end" class="stratum-label">{strataLabels[1]}</text>
          </g>

          <!-- Layer: Data -->
          <g data-layer>
            <path
              d="M250 168 L390 224 L250 280 L110 224 Z"
              fill="var(--c-paper)" stroke="var(--c-ink-3)" stroke-width="1.1"
              data-draw pathLength="1"
            ></path>
            <ellipse cx="250" cy="222" rx="26" ry="10" fill="none" stroke="var(--c-ink-3)" stroke-width="1" data-draw pathLength="1"></ellipse>
            <path d="M224 222 v10 a26 10 0 0 0 52 0 v-10" fill="none" stroke="var(--c-ink-3)" stroke-width="1" data-draw pathLength="1"></path>
            <line x1="110" y1="224" x2="64" y2="224" stroke="var(--c-line-2)" stroke-width="1" data-draw pathLength="1"></line>
            <text x="58" y="227" text-anchor="end" class="stratum-label">{strataLabels[2]}</text>
          </g>

          <!-- Layer: Infrastructure — the substrate, in cobalt -->
          <g data-layer>
            <path
              d="M250 248 L390 304 L250 360 L110 304 Z"
              fill="var(--c-accent-soft)" stroke="var(--c-accent)" stroke-width="1.3"
              data-draw pathLength="1"
            ></path>
            <!-- isometric mesh across the substrate face -->
            <path
              d="M222 259.2 L362 315.2 M194 270.4 L334 326.4 M166 281.6 L306 337.6 M138 292.8 L278 348.8"
              stroke="var(--c-accent)" stroke-width="0.8" opacity="0.38" data-draw pathLength="1"
            ></path>
            <path
              d="M278 259.2 L138 315.2 M306 270.4 L166 326.4 M334 281.6 L194 337.6 M362 292.8 L222 348.8"
              stroke="var(--c-accent)" stroke-width="0.8" opacity="0.38" data-draw pathLength="1"
            ></path>
            <g fill="var(--c-accent)">
              <circle data-node cx="250" cy="270.4" r="1.6"></circle>
              <circle data-node cx="194" cy="292.8" r="1.8"></circle>
              <circle data-node cx="250" cy="292.8" r="2.2"></circle>
              <circle data-node cx="306" cy="292.8" r="1.8"></circle>
              <circle data-node cx="194" cy="315.2" r="1.8"></circle>
              <circle data-node cx="250" cy="315.2" r="2.2"></circle>
              <circle data-node cx="306" cy="315.2" r="1.8"></circle>
              <circle data-node cx="250" cy="337.6" r="1.6"></circle>
            </g>
            <line x1="110" y1="304" x2="64" y2="304" stroke="var(--c-accent)" stroke-width="1" opacity="0.5" data-draw pathLength="1"></line>
            <text x="58" y="307" text-anchor="end" class="stratum-label stratum-label-accent">{strataLabels[3]}</text>
          </g>

          <!-- ground shadow -->
          <ellipse cx="250" cy="386" rx="130" ry="14" fill="var(--c-paper-2)" data-shadow></ellipse>

          <!-- descent line + pulses, drawn last so they travel over the strata -->
          <g data-descent>
            <line
              x1="250" y1="28" x2="250" y2="360"
              stroke="var(--c-line-2)" stroke-width="1" stroke-dasharray="2 5"
            ></line>
            <g data-pulse>
              <circle r="7" cx="250" cy="30" fill="var(--c-accent)" opacity="0.16"></circle>
              <circle r="3" cx="250" cy="30" fill="var(--c-accent)"></circle>
            </g>
            <g data-pulse-2>
              <circle r="5" cx="250" cy="30" fill="var(--c-accent)" opacity="0.14"></circle>
              <circle r="2.2" cx="250" cy="30" fill="var(--c-accent)" opacity="0.55"></circle>
            </g>
          </g>
        </svg>
        <figcaption class="sr-only">
          {t('hero.svgFigcaption')}
        </figcaption>
      </figure>
    </div>

    <!-- trust indicators -->
    <div class="mt-20 border-t border-line pt-7 md:mt-24" data-hero-item>
      <p class="kicker text-ink-3" id="hero-trust-heading">{t('hero.trustHeading')}</p>
      <ul class="mt-5 flex flex-wrap items-baseline gap-x-10 gap-y-3" aria-labelledby="hero-trust-heading">
        {
          trusted.map((name) => (
            <li class="display text-[0.95rem] tracking-[0.02em] text-ink-3 select-none">{name}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--c-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--c-line) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.42;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, black 30%, transparent 75%);
  }
  .hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -12%;
    width: 55%;
    height: 70%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c-accent) 9%, transparent), transparent);
    animation: hero-drift 22s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes hero-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-6%, 8%, 0) scale(1.12); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::after { animation: none; }
  }

  /* pathLength="1" normalizes every stroke, so a dash of 1 covers the full
     path when static and GSAP can draw it in from dashoffset 1 → 0 */
  [data-draw] {
    stroke-dasharray: 1;
  }

  .stratum-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
  .stratum-label-accent { fill: var(--c-accent); }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  if (!prefersReducedMotion()) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from('[data-hero-item]', { y: 26, opacity: 0, duration: 0.8, stagger: 0.09 }, 0.05);

    const layers = gsap.utils.toArray<Element>('.hero [data-layer]').reverse();
    tl.from(layers, { y: -18, opacity: 0, duration: 0.7, stagger: 0.12 }, 0.25);
    tl.from('.hero [data-shadow]', { opacity: 0, scaleX: 0.6, transformOrigin: '50% 50%', duration: 0.8 }, 0.3);
    tl.from('.hero [data-draw]', { strokeDashoffset: 1, duration: 1.1, ease: 'power2.inOut', stagger: 0.05 }, 0.4);
    tl.from('.hero [data-descent] line', { opacity: 0, duration: 0.6 }, 1.1);

    // idle: the stack breathes, bottom stratum leading
    gsap.to(layers, {
      y: -5,
      duration: 3.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      stagger: 0.4,
      delay: 1.8,
    });
    gsap.to('.hero [data-shadow]', {
      scaleX: 1.05,
      transformOrigin: '50% 50%',
      duration: 3.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 1.8,
    });

    // mesh nodes twinkle on the substrate face
    gsap.fromTo(
      '.hero [data-node]',
      { opacity: 0.35 },
      {
        opacity: 1,
        duration: 1.4,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        stagger: { each: 0.3, from: 'random' },
        delay: 1.6,
      }
    );

    // pulses descending through the stack, fading in at the top and out at the base
    const drop = (target: string, delay: number) =>
      gsap
        .timeline({ repeat: -1, delay, defaults: { ease: 'none' } })
        .fromTo(target, { y: 0, opacity: 0 }, { opacity: 1, duration: 0.35 }, 0)
        .to(target, { y: 330, duration: 3.4 }, 0)
        .to(target, { opacity: 0, duration: 0.45 }, 2.95);
    drop('[data-pulse]', 1.4);
    drop('[data-pulse-2]', 3.1);
  }
</script>
