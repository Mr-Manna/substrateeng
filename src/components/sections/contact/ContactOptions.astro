---
import SectionHeading from '../../SectionHeading.astro';
import { useTranslations } from '../../../i18n/useTranslations';

const locale = (Astro.currentLocale || 'en') as string;
const { t, tRaw } = useTranslations(locale);

const icons: Record<string, string> = {
  sales: 'M21 13.255A23.7 23.7 0 0 1 12 15.5c-3.183 0-6.22-.63-9-1.745M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2m4 6h.01M5 20h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z',
  engineering: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.72 1.72 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.72 1.72 0 0 0 1.066 2.573c1.756.426 1.756 2.924 0 3.35a1.72 1.72 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.72 1.72 0 0 0-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.72 1.72 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.72 1.72 0 0 0-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.72 1.72 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  partnerships: 'M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.575-5.963-1.575A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.994 5.994 0 0 0 12 12.75a5.994 5.994 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.479m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z',
  careers: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z',
  support: 'M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z',
};

const groups = ['sales', 'engineering', 'partnerships', 'careers', 'support'];
---

<section class="py-20 md:py-28" aria-labelledby="contact-options-heading">
  <div class="container-x">
    <SectionHeading
      id="contact-options-heading"
      index="08"
      label={t('contact.label')}
      title="Contact options."
      lede={t('contactOptions.lede')}
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {groups.map((key) => {
        const group = tRaw<{ title: string; description: string; items: string[] }>(`contactOptions.${key}`);
        return (
          <div
            class="group rounded-xl border border-line-2 bg-paper p-6 transition-all duration-200 hover:border-accent/20 hover:shadow-sm"
            data-reveal
          >
            <div class="flex items-start gap-4">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-1 h-6 w-6 shrink-0 text-accent"
                aria-hidden="true"
              >
                <path d={icons[key]} />
              </svg>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold text-ink">{group.title}</h3>
                <p class="mt-1 text-sm text-ink-2">{group.description}</p>
                <ul class="mt-4 space-y-1.5">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-ink-2">
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path d="m4 8 3 3 5-6" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
