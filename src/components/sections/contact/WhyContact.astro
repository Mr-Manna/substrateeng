---
import SectionHeading from '../../SectionHeading.astro';
import { useTranslations } from '../../../i18n/useTranslations';

const locale = (Astro.currentLocale || 'en') as string;
const { t, tRaw } = useTranslations(locale);

const points = tRaw<Array<{ title: string; text: string }>>('whyContact.points');
---

<section class="py-20 md:py-28" aria-labelledby="why-contact-heading">
  <div class="container-x">
    <SectionHeading
      id="why-contact-heading"
      index="—"
      label="Why Substrate"
      title={t('whyContact.heading')}
      lede={t('whyContact.lede')}
    />

    <div class="mt-14 grid gap-5 sm:grid-cols-2" data-reveal-group>
      {points.map((p, i) => (
        <div
          class="flex items-start gap-4 rounded-lg border border-line-2 bg-paper p-5 transition-all duration-200 hover:border-accent/20"
          data-reveal
        >
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="font-display font-semibold text-ink">{p.title}</h3>
            <p class="mt-1 text-sm text-ink-2 leading-relaxed">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
