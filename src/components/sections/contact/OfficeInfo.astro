---
import SectionHeading from '../../SectionHeading.astro';
import { useTranslations } from '../../../i18n/useTranslations';

const locale = (Astro.currentLocale || 'en') as string;
const { t, tRaw } = useTranslations(locale);

const offices = tRaw<Array<{ city: string; country: string; role: string; timezone: string; address: string }>>('officeInfo.offices');
---

<section class="bg-graphite py-20 md:py-28" aria-labelledby="office-heading">
  <div class="container-x">
    <SectionHeading
      id="office-heading"
      index="—"
      label="Office & Company"
      title={t('officeInfo.title')}
      lede={t('officeInfo.lede')}
      tone="graphite"
    />

    <div class="mt-14 grid gap-8 md:grid-cols-3" data-reveal-group>
      {offices.map((o) => (
        <div
          class="rounded-xl border border-graphite-line bg-graphite-2 p-6 transition-colors duration-200 hover:border-accent-bright/30"
          data-reveal
        >
          <div class="flex items-center gap-3 mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-accent-bright" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <h3 class="font-display text-lg font-semibold text-graphite-fg">{o.city}</h3>
          </div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent-bright uppercase">{o.role}</p>
          <p class="mt-2 text-sm text-graphite-fg-2">{o.country}</p>
          <p class="mt-1 font-mono text-xs text-graphite-fg-2">{o.timezone}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
      <div class="rounded-xl border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <h4 class="font-display font-semibold text-graphite-fg">Remote-first</h4>
        <p class="mt-2 text-sm text-graphite-fg-2 leading-relaxed">{t('officeInfo.remoteFirst')}</p>
      </div>
      <div class="rounded-xl border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <h4 class="font-display font-semibold text-graphite-fg">Global delivery</h4>
        <p class="mt-2 text-sm text-graphite-fg-2 leading-relaxed">{t('officeInfo.globalDelivery')}</p>
      </div>
    </div>

    <div class="mt-8 rounded-xl border border-graphite-line bg-graphite-2 p-6" data-reveal>
      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent-bright uppercase">Business hours</p>
          <p class="mt-1 text-sm text-graphite-fg-2">{t('officeInfo.businessHours')}</p>
        </div>
        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent-bright uppercase">Registered office</p>
          <p class="mt-1 text-sm text-graphite-fg-2">{t('officeInfo.registeredOffice')}</p>
        </div>
        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent-bright uppercase">Global reach</p>
          <p class="mt-1 text-sm text-graphite-fg-2">Engineers across 14 countries, delivery in 3 continents.</p>
        </div>
      </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-xl border border-graphite-line bg-graphite-2" data-reveal>
      <div class="aspect-[21/9] w-full bg-graphite flex items-center justify-center" role="img" aria-label="Map placeholder showing Substrate office locations in London, Singapore, and Toronto">
        <div class="text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-8 w-8 text-graphite-fg-2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <p class="mt-3 font-mono text-xs text-graphite-fg-2 tracking-[0.12em]">MAP: LONDON · SINGAPORE · TORONTO</p>
          <p class="mt-1 text-xs text-graphite-fg-2">Interactive map placeholder</p>
        </div>
      </div>
    </div>
  </div>
</section>
