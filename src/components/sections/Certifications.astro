---
interface Certification {
  name: string;
  label: string;
}

const certifications: Certification[] = [
  { name: 'ISO 27001', label: 'Information Security' },
  { name: 'CMMI Level 3', label: 'Process Maturity' },
  { name: 'SOC 2 Type II', label: 'Compliance' },
];
---

<section class="certifications-section py-20 md:py-28">
  <div class="container-x">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div>
        <p class="kicker text-ink-3" data-cert-item>Trusted & Verified</p>
        <h2 class="display mt-4 text-3xl md:text-4xl text-ink" data-cert-item>
          Industry-standard certifications
        </h2>
        <p class="mt-6 text-lg text-ink-2 max-w-md" data-cert-item>
          Our commitment to security, quality, and compliance is verified by leading industry standards.
        </p>
      </div>

      <div class="certifications-grid">
        {certifications.map((cert, index) => (
          <div class="certification-card" data-cert-item style={`--cert-index: ${index}`}>
            <svg
              class="cert-badge"
              viewBox="0 0 120 140"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id={`grad-${index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stopColor="var(--c-accent)" stopOpacity="0.2" />
                  <stop offset="100%" stopColor="var(--c-accent)" stopOpacity="0.05" />
                </linearGradient>
              </defs>

              <path
                d="M60 10 L100 30 L100 70 Q100 110 60 130 Q20 110 20 70 L20 30 Z"
                stroke="var(--c-accent)"
                strokeWidth="1.5"
                fill={`url(#grad-${index})`}
                data-badge-draw
              />

              <g data-badge-check>
                <path
                  d="M45 65 L55 75 L80 50"
                  stroke="var(--c-accent)"
                  strokeWidth="3"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  fill="none"
                />
              </g>

              <g data-badge-accent opacity="0.4">
                <line
                  x1="35"
                  y1="35"
                  x2="50"
                  y2="35"
                  stroke="var(--c-accent)"
                  strokeWidth="1"
                />
                <line
                  x1="70"
                  y1="35"
                  x2="85"
                  y2="35"
                  stroke="var(--c-accent)"
                  strokeWidth="1"
                />
              </g>
            </svg>

            <div class="cert-info">
              <h3 class="cert-name" data-badge-text>{cert.name}</h3>
              <p class="cert-label">{cert.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .certifications-section {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--c-accent) 3%, var(--c-paper)),
      var(--c-paper)
    );
    border-top: 1px solid var(--c-line);
  }

  .certifications-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .certification-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--c-line);
    border-radius: 12px;
    background: var(--c-paper);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  [data-cert-item] {
    opacity: 1 !important;
    transform: none !important;
  }

  .certification-card:hover {
    border-color: var(--c-accent);
    background: color-mix(in srgb, var(--c-accent-soft) 60%, var(--c-paper));
    transform: translateX(8px);
  }

  .cert-badge {
    width: 80px;
    height: 100px;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 8px color-mix(in srgb, var(--c-accent) 12%, transparent));
  }

  .certification-card:hover .cert-badge {
    filter: drop-shadow(0 4px 12px color-mix(in srgb, var(--c-accent) 20%, transparent));
  }

  [data-badge-draw] {
    stroke-dasharray: 1;
  }

  [data-badge-check] {
    opacity: 0;
  }

  .cert-info {
    flex: 1;
    min-width: 0;
  }

  .cert-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin: 0;
    line-height: 1.3;
  }

  .cert-label {
    font-size: 0.875rem;
    color: var(--c-ink-3);
    margin: 0.375rem 0 0 0;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .certification-card {
      padding: 1.25rem;
      gap: 1rem;
    }

    .cert-badge {
      width: 70px;
      height: 90px;
    }

    .cert-name {
      font-size: 0.95rem;
    }
  }

  :dark .certifications-section {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--c-accent) 8%, var(--c-paper)),
      var(--c-paper)
    );
    border-top-color: var(--c-line);
  }

  :dark .certification-card {
    border-color: var(--c-line);
    background: var(--c-paper);
  }

  :dark .certification-card:hover {
    background: color-mix(in srgb, var(--c-accent) 12%, var(--c-paper));
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  if (!prefersReducedMotion()) {
    setTimeout(() => {
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-cert-item]'));
      const badges = Array.from(document.querySelectorAll<SVGGeometryElement>('[data-badge-draw]'));
      const checks = Array.from(document.querySelectorAll<SVGElement>('[data-badge-check]'));

      if (items.length === 0) return;

      const section = document.querySelector('.certifications-section');
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          once: true,
        },
      });

      tl.from(items, {
        y: 16,
        opacity: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: 'power2.out',
      }, 0);

      badges.forEach((badge, i) => {
        try {
          const len = badge.getTotalLength?.() || 200;
          gsap.set(badge, { strokeDasharray: len, strokeDashoffset: len });
          tl.to(
            badge,
            { strokeDashoffset: 0, duration: 1, ease: 'power2.inOut' },
            0.15 + i * 0.15
          );
        } catch (e) {
          console.warn('Badge animation error:', e);
        }
      });

      checks.forEach((check, i) => {
        tl.to(check, { opacity: 1, duration: 0.4, ease: 'back.out' }, 0.5 + i * 0.15);
      });
    }, 100);
  }
</script>
