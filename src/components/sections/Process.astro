---
import SectionHeading from '../SectionHeading.astro';
import { useTranslations } from '../../i18n/useTranslations';
import type { Locale } from '../../i18n/config';
const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);

interface Phase {
  title: string;
  window: string;
  body: string;
  deliverables: string[];
  glyph: string;
  glyphAlt: string;
}

/*
 * Per-phase blueprint glyphs (220×150). [data-draw] strokes draw in when the
 * phase scrolls into view; [data-flow] carries a looping cobalt pulse.
 */
const glyphs: Record<string, string> = {
  discover: `
    <path data-draw d="M38 108 C 20 84, 44 58, 78 60 C 112 62, 128 44, 156 52 C 186 60, 196 88, 178 108 C 158 130, 120 128, 96 122 C 72 116, 52 126, 38 108 Z" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M62 100 C 52 86, 68 70, 92 72 C 116 74, 130 62, 148 70 C 166 78, 170 94, 156 104 C 140 115, 108 114, 92 108 C 78 103, 70 110, 62 100 Z" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M92 94 C 88 86, 98 80, 110 82 C 124 84, 134 82, 138 88 C 142 94, 132 100, 118 99 C 106 98, 96 100, 92 94 Z" stroke="var(--c-ink-3)" stroke-width="1"/>
    <circle cx="114" cy="90" r="2.5" fill="var(--c-accent)"/>
    <path data-draw d="M114 90 V38" stroke="var(--c-accent)" stroke-width="1.1"/>
    <path data-draw d="M114 38 l20 7 -20 7" stroke="var(--c-accent)" stroke-width="1.1"/>
    <text x="142" y="43" class="p-glyph-label">SITE A</text>
  `,
  architect: `
    <path data-draw d="M40 34 H180 V116 H40 Z" stroke="var(--c-ink)" stroke-width="1.2"/>
    <path data-draw d="M40 74 H104 M104 34 V74 M132 74 V116" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M118 74 a14 14 0 0 1 14 14" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M196 44 v-18 m0 0 l-5 8 m5 -8 l5 8" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M40 126 H180 M40 122 v8 M180 122 v8" stroke="var(--c-accent)" stroke-width="1"/>
    <text x="110" y="142" text-anchor="middle" class="p-glyph-label p-glyph-accent">42.0M</text>
  `,
  build: `
    <path data-draw d="M28 96 H192" stroke="var(--c-ink)" stroke-width="1.2"/>
    <path data-draw d="M64 96 C 76 96, 76 68, 92 68 H124 C 140 68, 140 96, 152 96" stroke="var(--c-ink-3)" stroke-width="1"/>
    <circle cx="44" cy="96" r="3" fill="var(--c-ink-3)"/>
    <circle cx="100" cy="68" r="3" fill="var(--c-ink-3)"/>
    <circle cx="122" cy="68" r="3" fill="var(--c-ink-3)"/>
    <circle cx="152" cy="96" r="3.5" fill="var(--c-accent)"/>
    <circle cx="176" cy="96" r="3" fill="var(--c-ink-3)"/>
    <path data-flow d="M28 96 H192" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
    <text x="110" y="126" text-anchor="middle" class="p-glyph-label">TRUNK — DAILY TO PROD</text>
  `,
  harden: `
    <path d="M40 116 V96 M60 116 V84 M80 116 V70 M100 116 V54" stroke="var(--c-ink-3)" stroke-width="7" opacity="0.25"/>
    <path data-draw d="M32 104 L56 92 L76 98 L96 66 L112 84 L128 48 L144 76 L158 42" stroke="var(--c-ink)" stroke-width="1.3" stroke-linejoin="round"/>
    <path data-draw d="M172 34 l14 6 v11 c0 8.5 -6 13.5 -14 17 c-8 -3.5 -14 -8.5 -14 -17 v-11 Z" stroke="var(--c-accent)" stroke-width="1.2" stroke-linejoin="round"/>
    <path data-draw d="M166 51 l4.5 5 9 -10" stroke="var(--c-accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="110" y="138" text-anchor="middle" class="p-glyph-label">BREAK IT FIRST</text>
  `,
  operate: `
    <path data-draw d="M28 76 H68 l6 -10 8 20 6 -10 H124 l6 -8 8 16 6 -8 H192" stroke="var(--c-ink)" stroke-width="1.2" stroke-linejoin="round"/>
    <path data-flow d="M28 76 H68 l6 -10 8 20 6 -10 H124 l6 -8 8 16 6 -8 H192" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
    <text x="28" y="114" class="p-glyph-label p-glyph-accent">SLO 99.99</text>
    <path data-draw d="M110 108 H170 m0 0 l-7 -5 m7 5 l-7 5" stroke="var(--c-ink-3)" stroke-width="1"/>
    <circle cx="184" cy="108" r="7" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <text x="110" y="138" text-anchor="middle" class="p-glyph-label">RUN, THEN HAND OVER</text>
  `,
};

const phaseKeys = ['discover', 'architect', 'build', 'harden', 'operate'];

const phases: Phase[] = phaseKeys.map((key, i) => ({
  title: t('process.phases.' + i + '.title'),
  window: t('process.phases.' + i + '.window'),
  body: t('process.phases.' + i + '.body'),
  deliverables: tRaw<string[]>('process.phases.' + i + '.deliverables'),
  glyph: key,
  glyphAlt: t('process.phases.' + i + '.glyphAlt'),
}));

---

<section id="process" class="py-24 md:py-36" aria-labelledby="process-heading">
  <div class="container-x">
    <SectionHeading
      id="process-heading"
      index="05"
      label={t('process.label')}
      title={t('process.title')}
      lede={t('process.lede')}
    />

    <div class="relative mt-16 md:mt-20" data-process>
      <!-- survey rail: fills with cobalt as the engagement descends -->
      <div class="absolute top-1 bottom-1 left-[5px] w-px bg-line" aria-hidden="true">
        <div class="process-rail-fill absolute inset-0 origin-top bg-accent" data-rail-fill></div>
      </div>

      <ol class="space-y-16 md:space-y-20">
        {
          phases.map((phase, i) => (
            <li class="relative pl-10 md:pl-14" data-phase data-reveal-group>
              <span
                class="phase-dot absolute top-1 left-0 h-[11px] w-[11px] rounded-full border-2 border-line-2 bg-paper transition-colors duration-500"
                aria-hidden="true"
              />
              <div class="items-start md:grid md:grid-cols-[minmax(0,1fr)_230px] md:gap-12">
                <div>
                  <p class="kicker text-ink-3" data-reveal>
                    <span class="text-accent">{String(i + 1).padStart(2, '0')}</span>
                    <span aria-hidden="true">&nbsp;·&nbsp;</span>
                    {phase.window}
                  </p>
                  <h3 class="mt-3 font-display text-2xl font-semibold text-ink" data-reveal>
                    {phase.title}
                  </h3>
                  <p class="mt-3 max-w-xl text-[0.98rem] leading-relaxed text-ink-2" data-reveal>
                    {phase.body}
                  </p>
                  <ul class="mt-5 flex flex-wrap gap-2" data-reveal>
                    {phase.deliverables.map((item) => (
                      <li class="rounded border border-line px-2.5 py-1 font-mono text-xs text-ink-2">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <svg
                  viewBox="0 0 220 150"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label={phase.glyphAlt}
                  class="mt-8 h-auto w-full max-w-[230px] md:mt-1"
                  set:html={glyphs[phase.glyph]}
                />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  [data-phase].is-passed .phase-dot {
    border-color: var(--c-accent);
  }

  /* set:html content is outside Astro's scoping — target it explicitly */
  #process :global(.p-glyph-label) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
  #process :global(.p-glyph-accent) {
    fill: var(--c-accent);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-process]');
  if (root && !prefersReducedMotion()) {
    const fill = root.querySelector('[data-rail-fill]');
    if (fill) {
      gsap.fromTo(
        fill,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: { trigger: root, start: 'top 72%', end: 'bottom 60%', scrub: 0.6 },
        }
      );
    }

    root.querySelectorAll<HTMLElement>('[data-phase]').forEach((phase) => {
      const draws = Array.from(phase.querySelectorAll<SVGGeometryElement>('[data-draw]'));
      draws.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });
      const flows = Array.from(phase.querySelectorAll<SVGGeometryElement>('[data-flow]'));
      flows.forEach((p) => (p.style.opacity = '0'));

      ScrollTrigger.create({
        trigger: phase,
        start: 'top 78%',
        once: true,
        onEnter: () => {
          phase.classList.add('is-passed');
          gsap.to(draws, {
            strokeDashoffset: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power1.inOut',
            onComplete: () => draws.forEach((p) => (p.style.strokeDasharray = 'none')),
          });
          flows.forEach((p) => {
            const len = p.getTotalLength();
            const period = len + 12;
            gsap.set(p, { strokeDasharray: `12 ${len}`, strokeDashoffset: 12, opacity: 1 });
            gsap.to(p, {
              strokeDashoffset: 12 - period,
              duration: Math.max(2.2, len / 80),
              ease: 'none',
              repeat: -1,
              delay: 0.9,
            });
          });
        },
      });
    });
  }
</script>
