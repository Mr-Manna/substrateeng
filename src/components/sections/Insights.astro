---
import SectionHeading from '../SectionHeading.astro';
import { featuredInsight, insights } from '../../data/insights';
import { useTranslations } from '../../i18n/useTranslations';
import type { Locale } from '../../i18n/config';
const locale = (Astro.currentLocale || 'en') as Locale;
const { t, tRaw } = useTranslations(locale);

/*
 * Featured diagram: a distributed-trace waterfall (460×220). Spans are thick
 * strokes so [data-draw] extends them left to right like a trace loading;
 * the slow ledger span draws last, in cobalt, and makes the essay's point.
 */
const traceWaterfall = `
  <path d="M120 34 V196 M197 34 V196 M274 34 V196 M351 34 V196 M428 34 V196" stroke="var(--c-line)" stroke-width="1"/>
  <text x="120" y="24" text-anchor="middle" class="i-label">0S</text>
  <text x="197" y="24" text-anchor="middle" class="i-label">1S</text>
  <text x="274" y="24" text-anchor="middle" class="i-label">2S</text>
  <text x="351" y="24" text-anchor="middle" class="i-label">3S</text>
  <text x="30" y="60" class="i-label">EDGE</text>
  <text x="30" y="88" class="i-label">AUTH</text>
  <text x="30" y="116" class="i-label">ORDERS</text>
  <text x="30" y="144" class="i-label">PRICING</text>
  <text x="30" y="172" class="i-label">LEDGER</text>
  <path data-draw d="M120 56 H428" stroke="var(--c-ink-3)" stroke-width="10" opacity="0.55"/>
  <path data-draw d="M136 84 H196" stroke="var(--c-ink-3)" stroke-width="10" opacity="0.55"/>
  <path data-draw d="M204 112 H352" stroke="var(--c-ink-3)" stroke-width="10" opacity="0.55"/>
  <path data-draw d="M216 140 H300" stroke="var(--c-ink-3)" stroke-width="10" opacity="0.55"/>
  <path data-draw d="M258 168 H418" stroke="var(--c-accent)" stroke-width="10" opacity="0.9"/>
  <text x="258" y="192" class="i-label i-label-accent">2.1S — LOCK WAIT, OWNER UNKNOWN</text>
`;

/*
 * Per-note marginalia glyphs (100×64). They draw in once on scroll and
 * replay their draw when the row is hovered.
 */
const glyphs: Record<string, string> = {
  strangler: `
    <path data-draw d="M14 16 H62 V48 H14 Z" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M30 16 V48 M46 16 V48" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M70 32 h16 m0 0 l-5 -4 m5 4 l-5 4" stroke="var(--c-accent)" stroke-width="1.2"/>
  `,
  streaming: `
    <circle cx="26" cy="32" r="5" stroke="var(--c-accent)" stroke-width="1.2"/>
    <path data-draw d="M31 32 C 50 20, 66 16, 84 14" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M31 32 H84" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M31 32 C 50 44, 66 48, 84 50" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="88" cy="14" r="2.5" fill="var(--c-ink-3)"/>
    <circle cx="88" cy="32" r="2.5" fill="var(--c-ink-3)"/>
    <circle cx="88" cy="50" r="2.5" fill="var(--c-ink-3)"/>
  `,
  evals: `
    <path data-draw d="M18 16 h16 v16 h-16 Z M42 16 h16 v16 h-16 Z M66 16 h16 v16 h-16 Z" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M18 40 h16 v16 h-16 Z M42 40 h16 v16 h-16 Z M66 40 h16 v16 h-16 Z" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M45 47 l4 5 7 -8" stroke="var(--c-accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  oncall: `
    <path data-draw d="M8 34 H32 l5 -12 8 22 5 -10 H92" stroke="var(--c-ink-3)" stroke-width="1.1" stroke-linejoin="round"/>
    <circle cx="50" cy="34" r="2.5" fill="var(--c-accent)"/>
  `,
  migration: `
    <path data-draw d="M18 46 h44 M18 34 h44 M18 22 h44" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-draw d="M76 48 V18 m0 0 l-5 7 m5 -7 l5 7" stroke="var(--c-accent)" stroke-width="1.2"/>
  `,
};
---

<section id="insights" class="py-24 md:py-36" aria-labelledby="insights-heading">
  <div class="container-x">
    <SectionHeading
      id="insights-heading"
      index={t('insights.index')}
      label={t('insights.label')}
      title={t('insights.title')}
      lede={t('insights.lede')}
    />

    <div class="mt-16 grid gap-x-16 gap-y-14 md:mt-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]" data-insights>
      <!-- featured note -->
      <article class="rounded border border-line bg-paper-2 p-7 md:p-9" data-featured data-reveal>
        <svg
          viewBox="0 0 460 220"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label={t('insights.featured.svgTitle')}
          class="h-auto w-full rounded border border-line bg-paper"
          set:html={traceWaterfall}
        />
        <p class="kicker mt-7 text-ink-3">
          <span class="text-accent">FEATURED</span>
          <span aria-hidden="true">&nbsp;·&nbsp;</span>
          {featuredInsight.ref}
        </p>
        <h3 class="display mt-4 text-2xl text-ink md:text-[1.8rem]">{t('insights.featured.title')}</h3>
        <p class="mt-3 text-[0.98rem] leading-relaxed text-ink-2">{t('insights.featured.excerpt')}</p>
        <p class="mt-5 font-mono text-xs tracking-[0.12em] text-ink-3">
          {featuredInsight.date} · {t('insights.featured.readingTime')}
        </p>
      </article>

      <!-- the log -->
      <div data-reveal-group>
        {
          insights.map((note, i) => (
            <article
              class="group grid grid-cols-[64px_minmax(0,1fr)] items-center gap-x-6 border-t border-line py-6 transition-colors duration-300 last:border-b hover:bg-paper-2 md:grid-cols-[84px_minmax(0,1fr)_110px]"
              data-note
              data-reveal
            >
              <svg
                viewBox="0 0 100 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label={t(`insights.items.${i}.glyphAlt`)}
                class="h-auto w-full"
                set:html={glyphs[note.glyph]}
              />
              <div>
                <p class="font-mono text-[0.7rem] tracking-[0.12em] text-ink-3 uppercase">
                  {note.date} · {t(`insights.items.${i}.category`)}
                </p>
                <h3 class="mt-1.5 font-display text-lg leading-snug font-semibold text-ink transition-colors duration-300 group-hover:text-accent">
                  {t(`insights.items.${i}.title`)}
                </h3>
              </div>
              <p class="hidden text-right font-mono text-xs tracking-[0.12em] text-ink-3 md:block">
                {note.readingTime}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* set:html content is outside Astro's scoping — target it explicitly */
  #insights :global(.i-label) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
  #insights :global(.i-label-accent) {
    fill: var(--c-accent);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-insights]');
  if (root && !prefersReducedMotion()) {
    const prep = (paths: SVGGeometryElement[]) =>
      paths.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

    const draw = (paths: SVGGeometryElement[], duration: number, stagger: number) =>
      gsap.to(paths, {
        strokeDashoffset: 0,
        duration,
        stagger,
        ease: 'power1.inOut',
        overwrite: true,
        onComplete: () => paths.forEach((p) => (p.style.strokeDasharray = 'none')),
      });

    // featured trace: spans load in sequence, the slow one lands last
    const featured = root.querySelector<HTMLElement>('[data-featured]');
    if (featured) {
      const spans = Array.from(featured.querySelectorAll<SVGGeometryElement>('[data-draw]'));
      prep(spans);
      ScrollTrigger.create({
        trigger: featured,
        start: 'top 75%',
        once: true,
        onEnter: () => draw(spans, 0.6, 0.18),
      });
    }

    // note glyphs: draw once on scroll, replay on hover
    root.querySelectorAll<HTMLElement>('[data-note]').forEach((row) => {
      const paths = Array.from(row.querySelectorAll<SVGGeometryElement>('[data-draw]'));
      prep(paths);
      let entered = false;

      ScrollTrigger.create({
        trigger: row,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          entered = true;
          draw(paths, 0.55, 0.08);
        },
      });

      row.addEventListener('mouseenter', () => {
        if (!entered) return;
        prep(paths);
        draw(paths, 0.45, 0.06);
      });
    });
  }
</script>
