---
import SectionHeading from '../SectionHeading.astro';
import { workCases, type WorkStat } from '../../data/work';

/*
 * Measurement charts (460×240), one per engagement. [data-draw] strokes draw
 * in on scroll; [data-flow] carries the looping cobalt pulse. Dashed reference
 * lines stay static (the draw trick erases dash patterns).
 */
const charts: Record<string, string> = {
  atlas: `
    <path d="M30 40 H430 M30 96 H430 M30 152 H430 M30 208 H430" stroke="var(--c-line)" stroke-width="1"/>
    <text x="30" y="28" class="w-label">P99 SETTLEMENT TIME</text>
    <path data-draw d="M30 62 L58 55 L86 64 L114 52 L142 63 L170 56 L198 65 L226 57 L240 58 L244 186 L272 184 L304 187 L336 184 L368 186 L400 184 L430 185" stroke="var(--c-ink)" stroke-width="1.3" stroke-linejoin="round"/>
    <path d="M244 36 V210" stroke="var(--c-accent)" stroke-width="1" stroke-dasharray="3 5" opacity="0.7"/>
    <text x="252" y="46" class="w-label w-label-accent">CUTOVER — WEEK 26</text>
    <text x="30" y="84" class="w-label">4.2S</text>
    <text x="430" y="174" text-anchor="end" class="w-label w-label-accent">180MS</text>
    <path data-flow d="M244 186 L272 184 L304 187 L336 184 L368 186 L400 184 L430 185" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
  `,
  meridian: `
    <circle cx="230" cy="122" r="58" stroke="var(--c-line-2)" stroke-width="1" stroke-dasharray="3 6"/>
    <path data-draw d="M230 122 C 180 100, 110 72, 58 58" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M230 122 C 170 140, 110 170, 52 178" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M230 122 C 205 90, 180 56, 150 36" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M230 122 C 285 100, 340 76, 392 60" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M230 122 C 290 142, 350 168, 404 178" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-draw d="M230 122 C 260 155, 285 194, 312 214" stroke="var(--c-ink-3)" stroke-width="1"/>
    <circle cx="230" cy="122" r="6" stroke="var(--c-accent)" stroke-width="1.4"/>
    <circle cx="230" cy="122" r="2.5" fill="var(--c-accent)"/>
    <circle cx="58" cy="58" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="52" cy="178" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="150" cy="36" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="392" cy="60" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="404" cy="178" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <circle cx="312" cy="214" r="3.5" stroke="var(--c-ink-3)" stroke-width="1.1"/>
    <path data-flow d="M230 122 C 285 100, 340 76, 392 60" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
    <path data-flow d="M230 122 C 170 140, 110 170, 52 178" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
    <path data-flow d="M230 122 C 260 155, 285 194, 312 214" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
    <text x="230" y="150" text-anchor="middle" class="w-label w-label-accent">HUB 02</text>
    <text x="392" y="48" text-anchor="middle" class="w-label">PORT</text>
    <text x="404" y="196" text-anchor="middle" class="w-label">DC 11</text>
    <text x="30" y="232" class="w-label w-label-accent">2.1M ROUTES REPLANNED DAILY</text>
  `,
  boreal: `
    <path d="M30 40 H430 M30 96 H430 M30 152 H430 M30 208 H430" stroke="var(--c-line)" stroke-width="1"/>
    <text x="30" y="28" class="w-label">INGEST — READINGS / SEC</text>
    <path d="M60 208 V178 M100 208 V166 M140 208 V152 M180 208 V132 M220 208 V116 M260 208 V100" stroke="var(--c-ink-3)" stroke-width="10" opacity="0.15"/>
    <path data-draw d="M30 198 L70 180 L110 168 L150 150 L190 130 L230 112 L270 96 L300 86" stroke="var(--c-ink)" stroke-width="1.3" stroke-linejoin="round"/>
    <path d="M300 44 V210" stroke="var(--c-ink-3)" stroke-width="1" stroke-dasharray="3 5" opacity="0.6"/>
    <text x="306" y="54" class="w-label">TODAY</text>
    <path d="M300 86 L340 76 L380 66 L430 54" stroke="var(--c-accent)" stroke-width="1.2" stroke-dasharray="4 5" opacity="0.85"/>
    <text x="430" y="42" text-anchor="end" class="w-label w-label-accent">FORECAST</text>
    <text x="292" y="76" text-anchor="end" class="w-label w-label-accent">1.2M/S</text>
    <path data-flow d="M30 198 L70 180 L110 168 L150 150 L190 130 L230 112 L270 96 L300 86" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
  `,
};

/** static text for a stat — what no-JS and reduced-motion visitors see */
const formatStat = (s: WorkStat) =>
  s.decimals ? s.value.toFixed(s.decimals) : s.value.toLocaleString('en-US');
---

<section id="work" class="bg-paper-2 py-24 md:py-36" aria-labelledby="work-heading">
  <div class="container-x">
    <SectionHeading
      id="work-heading"
      index="06"
      label="Work"
      title="Shipped, measured, and still running."
      lede="Client names stay behind NDAs; the numbers don’t. Three engagements, reported the way we report them internally — what was broken, what we built, what changed."
    />

    <div class="mt-8 md:mt-10" data-work>
      {
        workCases.map((c, i) => (
          <article
            class="grid items-center gap-x-16 gap-y-10 border-b border-line py-14 md:py-16 lg:grid-cols-2"
            data-case
            data-reveal-group
          >
            <div>
              <p class="kicker text-ink-3" data-reveal>
                <span class="text-accent">ENGAGEMENT {c.codename}</span>
                <span aria-hidden="true">&nbsp;·&nbsp;</span>
                {c.sector}
                <span aria-hidden="true">&nbsp;·&nbsp;</span>
                {c.duration}
              </p>
              <h3 class="display mt-5 max-w-xl text-[1.65rem] text-ink md:text-3xl" data-reveal>
                {c.title}
              </h3>
              <p class="mt-4 max-w-xl text-[0.98rem] leading-relaxed text-ink-2" data-reveal>
                {c.body}
              </p>
              <dl class="mt-8 grid grid-cols-3 gap-4" data-reveal>
                {c.stats.map((s) => (
                  <div class="border-l-2 border-line-2 pl-3">
                    <dd class="font-display text-xl font-semibold text-ink md:text-[1.6rem]">
                      {s.prefix}
                      <span
                        data-count
                        data-to={s.value}
                        data-decimals={s.decimals ?? 0}
                      >{formatStat(s)}</span>
                      {s.suffix}
                    </dd>
                    <dt class="mt-1 font-mono text-[0.68rem] tracking-[0.08em] text-ink-3 uppercase">
                      {s.note}
                    </dt>
                  </div>
                ))}
              </dl>
            </div>

            <figure class:list={[i % 2 === 1 && 'lg:order-first']} data-reveal>
              <svg
                viewBox="0 0 460 240"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label={c.figAlt}
                class="h-auto w-full rounded border border-line bg-paper"
                set:html={charts[c.chart]}
              />
              <figcaption class="mt-3 font-mono text-xs tracking-[0.12em] text-ink-3">
                {c.figCaption}
              </figcaption>
            </figure>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* set:html content is outside Astro's scoping — target it explicitly */
  #work :global(.w-label) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
  #work :global(.w-label-accent) {
    fill: var(--c-accent);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root && !prefersReducedMotion()) {
    const fmt = (v: number, decimals: number) =>
      decimals ? v.toFixed(decimals) : Math.round(v).toLocaleString('en-US');

    root.querySelectorAll<HTMLElement>('[data-case]').forEach((card) => {
      const draws = Array.from(card.querySelectorAll<SVGGeometryElement>('[data-draw]'));
      draws.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });
      const flows = Array.from(card.querySelectorAll<SVGGeometryElement>('[data-flow]'));
      flows.forEach((p) => (p.style.opacity = '0'));

      ScrollTrigger.create({
        trigger: card,
        start: 'top 72%',
        once: true,
        onEnter: () => {
          gsap.to(draws, {
            strokeDashoffset: 0,
            duration: 0.8,
            stagger: 0.1,
            ease: 'power1.inOut',
            onComplete: () => draws.forEach((p) => (p.style.strokeDasharray = 'none')),
          });

          flows.forEach((p, i) => {
            const len = p.getTotalLength();
            const period = len + 12;
            gsap.set(p, { strokeDasharray: `12 ${len}`, strokeDashoffset: 12, opacity: 1 });
            gsap.to(p, {
              strokeDashoffset: 12 - period,
              duration: Math.max(1.8, len / 110),
              ease: 'none',
              repeat: -1,
              delay: 0.8 + i * 0.25,
            });
          });

          // the outcome numbers count up to their measured values
          card.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
            const to = parseFloat(el.dataset.to ?? '0');
            const decimals = parseInt(el.dataset.decimals ?? '0', 10);
            const state = { v: 0 };
            gsap.to(state, {
              v: to,
              duration: 1.4,
              ease: 'power2.out',
              onUpdate: () => (el.textContent = fmt(state.v, decimals)),
            });
          });
        },
      });
    });
  }
</script>
