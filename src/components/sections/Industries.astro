    <path data-draw d="M48 176 C 120 168, 176 132, 232 104 C 272 84, 312 64, 344 52" stroke="var(--c-ink-3)" stroke-width="1"/>
    <path data-flow d="M48 176 C 120 168, 176 132, 232 104 C 272 84, 312 64, 344 52" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round"/>
