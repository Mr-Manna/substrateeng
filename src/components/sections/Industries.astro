};
---

<section id="industries" class="py-24 md:py-36" aria-labelledby="industries-heading">
  <div class="container-x">
    <SectionHeading
      id="industries-heading"
      index={t('industries.index')}
      label={t('industries.label')}
      title={t('industries.title')}
      lede={t('industries.lede')}
    />

    <div
      class="mt-14 grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14"
      data-industries
      data-reveal
    >
      <div
        role="tablist"
        aria-label={t('industries.label')}
        aria-orientation="vertical"
        class="-mx-6 flex gap-1 overflow-x-auto px-6 pb-2 md:-mx-10 md:px-10 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0 lg:pb-0"
      >
        {
          industries.map((ind, i) => (
            <button
              id={`industry-tab-${ind.id}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`industry-panel-${ind.id}`}
              tabindex={i === 0 ? 0 : -1}
              class="industry-tab flex shrink-0 cursor-pointer items-baseline gap-3 border-b-2 border-transparent px-4 py-3 text-left transition-colors lg:border-b-0 lg:border-l-2 lg:px-5"
            >
              <span class="font-mono text-xs text-ink-3">{String(i + 1).padStart(2, '0')}</span>
              <span class="industry-tab-name font-display text-[1.02rem] font-semibold whitespace-nowrap text-ink-3 transition-colors lg:whitespace-normal">
                {t('industries.items.' + i + '.name')}
              </span>
            </button>
          ))
        }
      </div>

      <div>
        {
          industries.map((ind, i) => (
            <div
              id={`industry-panel-${ind.id}`}
              role="tabpanel"
              aria-labelledby={`industry-tab-${ind.id}`}
              hidden={i !== 0}
              class="industry-panel"
            >
              <div class="grid overflow-hidden rounded-lg border border-line md:grid-cols-2">
                <div class="p-7 md:p-9">
                  <h3 class="font-display text-2xl font-semibold text-ink">{t('industries.items.' + i + '.name')}</h3>
                  <p class="mt-4 text-[0.98rem] leading-relaxed text-ink-2">{t('industries.items.' + i + '.positioning')}</p>
                  <p class="kicker mt-8 text-ink-3">{t('industries.weBuild')}</p>
                  <ul class="mt-3.5 flex flex-wrap gap-2">
                    {ind.systems.map((_system, j) => (
                      <li class="rounded border border-line px-2.5 py-1 font-mono text-xs text-ink-2">
                        {t('industries.items.' + i + '.systems.' + j)}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="border-t border-line bg-paper-2 p-5 md:border-t-0 md:border-l">
                  <svg
                    viewBox="0 0 380 260"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    role="img"
                    aria-label={`Line diagram: ${t('industries.items.' + i + '.name').toLowerCase()} systems`}
                    class="h-auto w-full"
                    set:html={vignettes[ind.id]}
                  />
                  <figcaption class="mt-2 px-1 font-mono text-[0.68rem] tracking-[0.12em] text-ink-3">
                    {t('industries.items.' + i + '.caption')}
                  </figcaption>
                </figure>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .industry-tab[aria-selected='true'] {
    border-color: var(--c-accent);
  }
  .industry-tab[aria-selected='true'] .industry-tab-name,
  .industry-tab:hover .industry-tab-name {
    color: var(--c-ink);
  }

  /* set:html content is outside Astro's scoping — target it explicitly */
  #industries :global(.v-label) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    fill: var(--c-ink-3);
  }
  #industries :global(.v-label-accent) {
    fill: var(--c-accent);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-industries]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const motionOk = !prefersReducedMotion();
    let flows: gsap.core.Tween[] = [];

    const stopFlows = () => {
      flows.forEach((t) => t.kill());
      flows = [];
    };

    /** Set [data-draw] paths to their undrawn state (visible panel only). */
    const prepDraws = (panel: HTMLElement) =>
      panel.querySelectorAll<SVGPathElement>('[data-draw]').forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

    const animateIn = (panel: HTMLElement) => {
      stopFlows();
      prepDraws(panel);
      const draws = Array.from(panel.querySelectorAll<SVGPathElement>('[data-draw]'));

      const tl = gsap.timeline();
      tl.fromTo(
        panel,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', clearProps: 'all' }
      );
      tl.to(
        draws,
        {
          strokeDashoffset: 0,
          duration: 0.7,
          stagger: 0.1,
          ease: 'power1.inOut',
          onComplete: () => draws.forEach((p) => (p.style.strokeDasharray = 'none')),
        },
        0.1
      );

      // a cobalt pulse loops along each [data-flow] path while the panel is active
      panel.querySelectorAll<SVGPathElement>('[data-flow]').forEach((p) => {
        const len = p.getTotalLength();
        const period = len + 16;
        gsap.set(p, { strokeDasharray: `16 ${len}`, strokeDashoffset: 16, opacity: 1 });
        flows.push(
          gsap.to(p, {
            strokeDashoffset: 16 - period,
            duration: Math.max(2.6, len / 80),
            ease: 'none',
            repeat: -1,
            delay: 0.6,
          })
        );
      });
    };

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
      if (motionOk) animateIn(panels[index]);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const dirs: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
        let next: number | undefined;
        if (e.key in dirs) next = (i + dirs[e.key] + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next !== undefined) {
          e.preventDefault();
          select(next);
        }
      });
    });

    // First vignette draws itself when the section scrolls into view.
    // Without motion, everything stays fully drawn and tabs switch instantly.
    if (motionOk) {
      root.querySelectorAll<SVGPathElement>('[data-flow]').forEach((p) => (p.style.opacity = '0'));
      prepDraws(panels[0]);
      ScrollTrigger.create({
        trigger: root,
        start: 'top 75%',
        once: true,
        onEnter: () => animateIn(panels[0]),
      });
    }
  }
</script>
