---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Capabilities', href: '/#capabilities' },
  { name: 'SRE & Operations', href: '' },
];
---

<Base
  title="Site Reliability Engineering Services | Substrate"
  description="Substrate helps enterprises build reliable, observable, and automated platforms with SRE, platform engineering, and cloud operations. Reduce downtime, accelerate deployments, and operate at scale."
>
<!-- ============================================================ -->
<!-- 1. HERO -->
<!-- ============================================================ -->
<section class="relative overflow-hidden py-24 md:py-40" aria-labelledby="hero-heading">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--c-accent-soft)_0%,_transparent_60%)] pointer-events-none" aria-hidden="true" />
  <div class="container-x relative z-10">
    <nav class="mb-10 text-sm text-ink-3">
      {breadcrumbs.map((crumb, idx) => (
        <span>
          {idx > 0 && ' / '}
          {crumb.href && idx < breadcrumbs.length - 1
            ? <a href={crumb.href} class="text-accent hover:underline">{crumb.name}</a>
            : <span class={idx === breadcrumbs.length - 1 ? 'font-medium text-ink' : ''}>{crumb.name}</span>
          }
        </span>
      ))}
    </nav>

    <div class="max-w-4xl" data-reveal-group>
      <p class="kicker text-accent mb-5" data-reveal>
        <span class="text-accent">01</span><span aria-hidden="true">&nbsp;—&nbsp;</span>Site Reliability Engineering
      </p>
      <h1 id="hero-heading" class="display text-5xl md:text-[4.5rem] text-ink max-w-5xl" data-reveal>
        Reliable systems.<br />Automated operations.<br />Engineering-led resilience.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-ink-2 max-w-2xl leading-relaxed" data-reveal>
        Site Reliability Engineering is the practice of applying software engineering principles to infrastructure and operations. Substrate helps organizations adopt SRE to reduce downtime, eliminate toil, increase deployment confidence, and build platforms that scale with your business.
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal>
        <Button href="/contact" variant="primary" size="md">Schedule an SRE assessment</Button>
        <Button href="#what-is" variant="secondary" size="md">Learn more</Button>
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3 max-w-4xl" data-reveal-group>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">99.99%</p>
        <p class="text-sm text-ink-2 mt-1">Target availability achieved through SLO-driven operations and automated recovery</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">70%</p>
        <p class="text-sm text-ink-2 mt-1">Reduction in operational toil through automation-first incident response and runbooks</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">5x</p>
        <p class="text-sm text-ink-2 mt-1">Faster mean time to recovery with structured incident management and chaos engineering</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 2. WHAT IS SITE RELIABILITY ENGINEERING? -->
<!-- ============================================================ -->
<section id="what-is" class="py-20 md:py-28 bg-graphite" aria-labelledby="whatis-heading">
  <div class="container-x">
    <SectionHeading
      id="whatis-heading"
      index="02"
      label="What is Site Reliability Engineering"
      title="Engineering discipline for operating reliably at scale."
      lede="SRE is what happens when you ask a software engineer to design an operations team. It is a set of principles, practices, and organizational patterns that make systems reliable without sacrificing velocity."
      tone="graphite"
    />

    <div class="mt-14 grid gap-10 md:grid-cols-2 lg:gap-16" data-reveal-group>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Definition and core principles</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Site Reliability Engineering, originally defined at Google, is the discipline of operating large-scale systems with software engineering rigor. It treats operations as a software problem: automate everything, measure everything, and use data to drive decisions.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          The core principles are: service level objectives define acceptable risk, error budgets balance reliability with velocity, toil must be systematically eliminated, monitoring must be actionable, and incidents are learning opportunities. Every operational process should be evaluated on whether it can be automated, reduced, or eliminated.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">SRE, DevOps, Platform Engineering, and IT Operations</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          These disciplines are complementary, not competing. DevOps is the cultural foundation that breaks down silos between development and operations. SRE provides the engineering methodology and metrics to operate reliably. Platform Engineering builds the self-service infrastructure that makes both scalable. Traditional IT Operations handles the steady-state management of established systems.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          In practice, SRE sits at the intersection: applying software engineering to operations, using data to drive decisions, and building automation that makes the entire organization more effective.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Why modern businesses adopt SRE</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Organizations adopt SRE when the cost of downtime exceeds the cost of prevention. As systems grow, traditional operations approaches break down: manual runbooks cannot keep pace, incident response becomes chaotic, and engineering velocity stalls because every deployment carries too much risk.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          SRE provides a framework for making explicit decisions about reliability. How reliable does this system need to be? What are we willing to trade for faster delivery? How do we know when we have succeeded? These questions are answered with data, not intuition.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Common misconceptions</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">SRE is not just monitoring and alerting.</strong> Observability is a prerequisite, but SRE encompasses incident response, capacity planning, change management, and cultural transformation.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">Error budgets do not mean lowering standards.</strong> They provide a data-driven mechanism for deciding when reliability is good enough and when to invest in features versus stability.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">SRE is not only for Google-scale companies.</strong> The principles scale down as effectively as they scale up. Any organization with production systems benefits from SRE practices.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">SRE is not a team title.</strong> It is a practice and a culture. A team called SRE without SLOs, error budgets, and automation is an operations team with a different name.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>


<!-- ============================================================ -->
<!-- 3. BUSINESS CHALLENGES -->
<!-- ============================================================ -->
<section class="py-20 md:py-28" aria-labelledby="challenges-heading">
  <div class="container-x">
    <SectionHeading
      id="challenges-heading"
      index="03"
      label="Business Challenges"
      title="The operational cost of unreliable systems."
      lede="Without SRE practices, organizations accumulate technical debt, operational risk, and engineering friction. These are the patterns we see across every industry and scale."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">01</span>
          <h3 class="font-display font-semibold text-ink">Frequent production incidents</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Unplanned outages and degraded performance erode customer trust and drain engineering resources. Each incident pulls teams away from strategic work.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">02</span>
          <h3 class="font-display font-semibold text-ink">Service outages</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Extended downtime directly impacts revenue, SLA penalties, brand reputation, and regulatory compliance. Recovery is slow without automated runbooks.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">03</span>
          <h3 class="font-display font-semibold text-ink">Unreliable deployments</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Every deployment carries risk. Without canary releases, feature flags, and automated rollback, a bad deploy can impact all users for hours.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">04</span>
          <h3 class="font-display font-semibold text-ink">High operational overhead</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Manual processes for provisioning, deployment, and incident response consume engineering time that should be spent on product development and improvement.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">05</span>
          <h3 class="font-display font-semibold text-ink">Alert fatigue</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Noisy, poorly configured alerting desensitizes on-call engineers. Critical signals are lost in a flood of notifications that nobody trusts or acts on.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">06</span>
          <h3 class="font-display font-semibold text-ink">Poor monitoring</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Without comprehensive metrics, traces, and logs, teams operate blind. Root cause analysis takes hours or days. Blind spots create risk in every change.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">07</span>
          <h3 class="font-display font-semibold text-ink">Slow incident response</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Unstructured incident response prolongs downtime. Teams lack clear roles, communication channels, and escalation paths during critical events.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">08</span>
          <h3 class="font-display font-semibold text-ink">Scaling challenges</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Infrastructure and operational processes that work for ten services fail at one hundred. Complexity grows non-linearly with system scale.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">09</span>
          <h3 class="font-display font-semibold text-ink">Infrastructure complexity</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Multi-cloud, hybrid, and distributed architectures create operational blind spots. Configuration drift, networking issues, and dependency management become unmanageable.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">10</span>
          <h3 class="font-display font-semibold text-ink">Cloud cost growth</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Without capacity planning and cost governance, cloud spending grows faster than revenue. Over-provisioned resources and orphaned capacity accumulate silently.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">11</span>
          <h3 class="font-display font-semibold text-ink">Security risks</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Unpatched dependencies, misconfigured services, and ad hoc access controls create vulnerabilities that compliance frameworks cannot adequately address.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">12</span>
          <h3 class="font-display font-semibold text-ink">Knowledge silos</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Critical operational knowledge lives in individuals, not documentation or automation. Bus factor is high. On-call rotations are stressful and unsustainable.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">13</span>
          <h3 class="font-display font-semibold text-ink">Manual operations</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Repetitive manual tasks create human error risk, slow response times, and prevent engineers from focusing on high-value improvements and automation.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">14</span>
          <h3 class="font-display font-semibold text-ink">Low engineering productivity</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Operational burden reduces feature velocity. Engineers spend more time firefighting and maintaining than building. Deployment frequency drops and lead time increases.</p>
      </div>
    </div>
  </div>
</section>


<!-- ============================================================ -->
<!-- 4. OUR RELIABILITY ENGINEERING APPROACH -->
<!-- ============================================================ -->
<section class="py-20 md:py-28 bg-graphite" aria-labelledby="approach-heading">
  <div class="container-x">
    <SectionHeading
      id="approach-heading"
      index="04"
      label="Our Approach"
      title="A systematic methodology for reliability."
      lede="We follow a phased approach that starts with understanding your current state and ends with continuous operational improvement. Every engagement is tailored to your architecture, team, and business context."
      tone="graphite"
    />

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">01</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Reliability Assessment</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Evaluate current system reliability, incident patterns, monitoring coverage, and operational processes. We produce a quantified reliability baseline with prioritized gaps.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">02</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Operational Maturity Review</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Assess incident response, change management, on-call practices, runbook coverage, and automation maturity against industry standards and SRE best practices.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">03</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Architecture Review</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Analyze system architecture for single points of failure, scalability bottlenecks, dependency chains, and resilience patterns. We identify specific reliability risks and remediation paths.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">04</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">SRE Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define your SRE adoption roadmap: team structure, practice areas, tooling strategy, and success metrics. We align reliability investments with business priorities and risk tolerance.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">05</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Service Level Objectives</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define SLOs for critical services based on user expectations and business requirements. We help you determine the right reliability targets, not maximum theoretical uptime.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">06</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Service Level Indicators</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Identify and instrument the metrics that matter: availability, latency, throughput, error rate, and durability. Every SLI is chosen for its direct relationship to user experience.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">07</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Error Budget Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Implement error budgets that create a shared language between product and reliability teams. When the budget is available, ship features. When it is depleted, invest in stability.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">08</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Reliability Roadmap</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">A prioritized, phased plan for improving reliability across your organization. Each initiative includes expected impact, effort estimate, and success criteria.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">09</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Automation Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Identify and eliminate toil. We prioritize automation opportunities by frequency, complexity, and impact. Every automated process reduces incident risk and frees engineering capacity.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">10</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Operational Excellence</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Establish operational runbooks, change management procedures, release processes, and on-call best practices. Every process is documented, tested, and continuously improved.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">11</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Continuous Improvement</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">SRE is never done. We establish feedback loops, reliability reviews, post-incident processes, and maturity tracking to drive ongoing operational improvement.</p>
      </div>
    </div>
  </div>
</section>


<!-- ============================================================ -->
<!-- 5. SRE & OPERATIONS SERVICES -->
<!-- ============================================================ -->
<section class="py-20 md:py-28" aria-labelledby="services-heading">
  <div class="container-x">
    <SectionHeading
      id="services-heading"
      index="05"
      label="Our Services"
      title="End-to-end SRE and operations capabilities."
      lede="From assessment through managed operations, we provide the full spectrum of services needed to build, operate, and continuously improve reliable systems."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Site Reliability Engineering</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Full SRE practice implementation including SLO framework, error budgets, automation, incident management, and cultural transformation across your engineering organization.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> SLO design and implementation</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Error budget policy and governance</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Toil reduction and automation</li>
        </ul>
      </div>
