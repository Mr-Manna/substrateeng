        lede="From kickoff to roadmap delivery, every engagement follows a structured model that ensures consistency, transparency, and quality."
      />

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {[
          { name: 'Kickoff', desc: 'Scope confirmation, stakeholder identification, information requests, scheduling, and NDA execution. Day one.' },
          { name: 'Discovery', desc: 'Documentation review, system inventory, initial stakeholder interviews, and baseline establishment. Week 1.' },
          { name: 'Assessment', desc: 'Deep evaluation across all capability areas. Architecture review, technology review, interviews, and data collection. Weeks 2–4.' },
          { name: 'Analysis', desc: 'Findings synthesis, gap analysis, risk assessment, opportunity identification, and maturity scoring. Week 5.' },
          { name: 'Recommendations', desc: 'Quick wins, medium-term initiatives, long-term strategy, investment estimates, and roadmap development. Week 6.' },
          { name: 'Executive Review', desc: 'Presentation of findings to senior leadership. Strategic discussion, Q&A, and alignment on priorities. Week 6.' },
          { name: 'Roadmap Delivery', desc: 'Final deliverables package: executive summary, full report, architecture diagrams, and prioritized roadmap. Week 6.' },
          { name: 'Optional: Implementation', desc: 'If desired, Substrate provides implementation services aligned to assessment recommendations. Separately scoped and priced.' },
          { name: 'Continuous Advisory', desc: 'Ongoing advisory retainer for architecture guidance, technology evaluation, and periodic check-point assessments.' },
        ].map((step, i) => (
          <div class="flex flex-col p-5 rounded-lg border border-line bg-paper" data-reveal>
            <span class="kicker text-accent text-[0.7rem]">{(i + 1).toString().padStart(2, '0')}</span>
