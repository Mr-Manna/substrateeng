  <!-- 13. CALL TO ACTION -->
  <section class="py-24 md:py-36 bg-graphite text-graphite-fg relative overflow-hidden" aria-labelledby="cta-heading">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--c-accent-bright)_0%,_transparent_60%)] opacity-20 pointer-events-none" aria-hidden="true" />
    <div class="container-x relative z-10 text-center">
