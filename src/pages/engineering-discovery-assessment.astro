---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Engineering Discovery & Assessment', href: '' },
];

const assessCards = [
  { title: 'Business Strategy Alignment', description: 'How well technology investments support business objectives, revenue goals, and competitive positioning.' },
  { title: 'Technology Landscape', description: 'Inventory of platforms, frameworks, languages, tools, and runtimes across the organization.' },
  { title: 'Enterprise Architecture', description: 'Domain boundaries, system relationships, integration patterns, and architectural governance.' },
  { title: 'Application Portfolio', description: 'Application health, ownership, lifecycle stage, dependencies, and rationalization opportunities.' },
  { title: 'Cloud Architecture', description: 'Landing zone design, account structure, networking topology, and multi-cloud strategy.' },
  { title: 'Platform Engineering', description: 'Internal developer platform maturity, golden paths, self-service capability, and developer portals.' },
  { title: 'Infrastructure', description: 'Compute, storage, and network infrastructure — on-premises, cloud, and hybrid.' },
  { title: 'DevOps', description: 'CI/CD pipeline maturity, GitOps practices, deployment frequency, and release reliability.' },
  { title: 'Developer Experience', description: 'Local development environment, feedback loops, tooling quality, and friction points in the engineering workflow.' },
  { title: 'Site Reliability Engineering', description: 'SLO definitions, error budgets, incident response, on-call practices, and reliability culture.' },
  { title: 'Security', description: 'Zero-trust architecture, identity management, encryption posture, vulnerability management, and security operations.' },
  { title: 'Compliance', description: 'Regulatory coverage, policy-as-code maturity, audit readiness, and compliance automation.' },
  { title: 'Networking', description: 'Network architecture, segmentation, connectivity patterns, latency, and bandwidth constraints.' },
  { title: 'Identity & Access', description: 'Authentication, authorization, RBAC, directory services, and federation across systems.' },
  { title: 'Data Platforms', description: 'Data warehouse, data lake, lakehouse, streaming platforms, and database architecture.' },
  { title: 'Data Quality', description: 'Data accuracy, completeness, consistency, timeliness, and the processes that govern them.' },
  { title: 'Analytics', description: 'Business intelligence, reporting infrastructure, self-service analytics, and data product maturity.' },
  { title: 'AI Readiness', description: 'Model infrastructure, training pipelines, evaluation frameworks, prompt engineering practices, and AI governance.' },
  { title: 'Automation', description: 'Infrastructure as code, configuration management, policy as code, and toil reduction programs.' },
  { title: 'Performance', description: 'Load testing practices, performance monitoring, latency budgets, capacity planning, and bottleneck analysis.' },
  { title: 'Observability', description: 'Tracing, metrics, logging, dashboarding, alerting, and the culture of using telemetry to understand production behavior.' },
  { title: 'API Landscape', description: 'API inventory, design standards, versioning strategy, gateway infrastructure, and lifecycle management.' },
  { title: 'Integration', description: 'System integration patterns, middleware, event-driven architecture, API gateways, and integration testing.' },
  { title: 'Technical Debt', description: 'Known and unknown technical debt: outdated dependencies, workarounds, missing tests, architectural drift.' },
  { title: 'Governance', description: 'Architecture review boards, decision records, standards enforcement, and technology approval processes.' },
  { title: 'Cloud Cost Optimization', description: 'FinOps maturity, resource utilization, reserved instance strategy, tagging hygiene, and cost allocation.' },
  { title: 'Operational Processes', description: 'Change management, release processes, incident management, capacity planning, and operational runbooks.' },
  { title: 'Disaster Recovery', description: 'DR strategy, RTO/RPO targets, backup architecture, recovery testing, and business continuity planning.' },
  { title: 'Business Continuity', description: 'Continuity planning, failover architecture, dependency analysis, and resilience testing.' },
  { title: 'Knowledge Management', description: 'Documentation practices, knowledge bases, runbooks, decision logs, and information discoverability.' },
  { title: 'Documentation', description: 'Architecture documentation, API documentation, operational runbooks, onboarding guides, and system diagrams.' },
  { title: 'Engineering Team Maturity', description: 'Team structure, engineering practices, code review culture, testing discipline, and technical skill distribution.' },
  { title: 'Vendor Dependencies', description: 'Vendor lock-in risk, licensing costs, support obligations, and exit strategy feasibility.' },
];

const phases = [
  { name: 'Discovery', desc: 'Initial information gathering. We review documentation, system diagrams, configuration repositories, monitoring dashboards, and incident histories to establish a baseline understanding before any interviews.' },
  { name: 'Stakeholder Interviews', desc: 'Structured conversations with engineering leaders, product managers, architects, and team members. We collect perspectives on what works, what is painful, and what is invisible to existing monitoring.' },
  { name: 'Business Goals', desc: 'We map business objectives, revenue drivers, growth targets, and competitive pressures to technology requirements. Every technical finding is grounded in business context.' },
  { name: 'Current-State Assessment', desc: 'Systematic evaluation of every capability area. We measure current maturity, identify gaps, and document findings with supporting evidence.' },
  { name: 'Architecture Review', desc: 'In-depth review of system architecture: domain boundaries, service decomposition, integration patterns, data flow, failure modes, and scalability characteristics.' },
  { name: 'Technology Review', desc: 'Evaluation of the technology stack: frameworks, languages, databases, middleware, cloud services, and infrastructure. We assess suitability, maintainability, and lifecycle risk.' },
  { name: 'Engineering Review', desc: 'Assessment of engineering practices: CI/CD maturity, testing coverage, code review culture, branching strategy, developer experience, and delivery velocity.' },
  { name: 'Operational Review', desc: 'Evaluation of run-time practices: monitoring, alerting, incident response, capacity management, release engineering, and operational runbooks.' },
  { name: 'Security Review', desc: 'Security posture assessment: identity management, network security, application security, vulnerability management, and compliance alignment.' },
  { name: 'Gap Analysis', desc: 'Comparison of current state against industry standards, business requirements, and target future state. We identify and prioritize gaps by business impact.' },
  { name: 'Risk Assessment', desc: 'Identification and prioritization of risks: technical, operational, security, compliance, and vendor-related. Each risk is categorized by likelihood and business impact.' },
  { name: 'Opportunity Identification', desc: 'Mapping of improvement opportunities: quick wins that can be implemented immediately, medium-term investments, and strategic initiatives that require multi-quarter planning.' },
  { name: 'Future-State Vision', desc: 'A target architecture and operational model aligned with business strategy. We define what good looks like for your organization in specific, measurable terms.' },
  { name: 'Roadmap Development', desc: 'A phased execution plan with prioritized initiatives, estimated effort, dependencies, resource requirements, and expected business outcomes.' },
  { name: 'Executive Presentation', desc: 'A concise presentation for senior leadership summarizing findings, strategic recommendations, and the investment case for each initiative.' },
];

const deliverables = [
  { name: 'Executive Summary', desc: 'A concise overview of findings, key recommendations, and expected business impact. Designed for CIOs, CTOs, and board-level stakeholders.' },
  { name: 'Technology Landscape Assessment', desc: 'Comprehensive inventory and evaluation of the organization\'s technology stack, including lifecycle analysis, dependency mapping, and modernization candidates.' },
  { name: 'Architecture Review', desc: 'Detailed analysis of system architecture: strengths, weaknesses, risks, and recommended improvements for each architectural domain.' },
  { name: 'Engineering Maturity Score', desc: 'Quantified maturity rating across engineering practices, team capabilities, and delivery processes. Benchmarkable against industry standards.' },
  { name: 'Capability Maturity Matrix', desc: 'A structured matrix mapping every assessed capability to its maturity level, with specific evidence and recommended next steps for each.' },
  { name: 'SWOT Analysis', desc: 'Strategic assessment of strengths, weaknesses, opportunities, and threats across technology, process, organization, and governance dimensions.' },
  { name: 'Technical Debt Report', desc: 'Catalog of identified technical debt with severity ratings, remediation effort estimates, and prioritized resolution recommendations.' },
  { name: 'Cloud Assessment', desc: 'Evaluation of cloud architecture, cost optimization opportunities, migration readiness, and cloud operating model maturity.' },
  { name: 'Security Findings', desc: 'Documented security vulnerabilities, misconfigurations, and compliance gaps with prioritized remediation plans.' },
  { name: 'Operational Findings', desc: 'Assessment of operational practices, incident response maturity, observability coverage, and reliability gaps.' },
  { name: 'Risk Register', desc: 'Comprehensive risk register with likelihood, impact, owner, and mitigation recommendations for each identified risk.' },
  { name: 'Quick Wins', desc: 'High-impact, low-effort improvements that can be implemented immediately — often within weeks — while longer-term initiatives are planned.' },
  { name: 'Medium-Term Recommendations', desc: 'Initiatives with significant business value that require 2–6 months of focused execution. Suitable for inclusion in the next planning cycle.' },
  { name: 'Long-Term Strategy', desc: 'Strategic initiatives that require multi-quarter investment and organizational commitment. Includes target architecture and future-state operating model.' },
  { name: 'Prioritized Roadmap', desc: 'A phased implementation plan with clear sequencing, dependencies, resourcing requirements, and milestone definitions.' },
  { name: 'Investment Recommendations', desc: 'Budget estimates, resourcing requirements, ROI projections, and build-versus-buy analysis for each recommended initiative.' },
  { name: 'Implementation Phases', desc: 'Detailed phase definitions with scope, deliverables, team composition, duration estimates, and success criteria for each phase.' },
  { name: 'Architecture Diagrams', desc: 'Current-state and future-state architecture diagrams, including context diagrams, container diagrams, deployment diagrams, and data flow diagrams.' },
  { name: 'Executive Presentation', desc: 'A boardroom-ready presentation summarizing findings, recommendations, and the business case for investment. Designed for 30–60 minute executive reviews.' },
];

const industries = [
  { name: 'Financial Services', desc: 'Core banking systems, payment processing, trading platforms, risk management, and regulatory technology.' },
  { name: 'Healthcare', desc: 'Clinical systems, health information exchange, patient portals, research platforms, and compliance with healthcare regulations.' },
  { name: 'Retail', desc: 'E-commerce platforms, order management, inventory systems, pricing engines, and omnichannel architecture.' },
  { name: 'Manufacturing', desc: 'Supply chain systems, IoT platforms, production scheduling, quality management, and industrial automation.' },
  { name: 'Logistics', desc: 'Fleet management, route optimization, warehouse systems, tracking platforms, and last-mile delivery infrastructure.' },
  { name: 'Education', desc: 'Learning management systems, student information systems, assessment platforms, and research computing infrastructure.' },
  { name: 'Government', desc: 'Digital service platforms, identity systems, citizen portals, data exchange, and compliance with public-sector standards.' },
  { name: 'Telecommunications', desc: 'Network management, billing systems, customer platforms, edge computing, and 5G infrastructure.' },
  { name: 'Media', desc: 'Content management, streaming platforms, recommendation engines, advertising technology, and digital rights management.' },
  { name: 'SaaS', desc: 'Multi-tenant architecture, platform scalability, feature delivery velocity, and infrastructure cost optimization.' },
  { name: 'Artificial Intelligence', desc: 'ML infrastructure, training pipelines, model deployment, evaluation frameworks, and AI governance.' },
  { name: 'Life Sciences', desc: 'Research data platforms, clinical trial systems, regulatory compliance, and laboratory information management.' },
];

const reasons = [
  { title: 'Independent Recommendations', desc: 'We have no reseller agreements, OEM partnerships, or commission structures. Every recommendation is based on what is right for your organization, not our margin.' },
  { title: 'Vendor-Neutral Advice', desc: 'We maintain deep expertise across AWS, Azure, GCP, and the open-source ecosystem. Our advice is cloud-agnostic and tool-agnostic by default.' },
  { title: 'Engineering-First Mindset', desc: 'We are an engineering company, not a management consulting firm. Our assessments are conducted by engineers who have designed, built, and operated production systems at scale.' },
  { title: 'Enterprise Architecture Expertise', desc: 'Decades of experience defining target-state architectures, domain boundaries, and technology roadmaps for organizations with complex legacy environments.' },
  { title: 'Platform Engineering Expertise', desc: 'We are recognized practitioners in platform engineering. Our assessment evaluates your platform maturity against industry standards and real-world experience.' },
  { title: 'Cloud-Native Expertise', desc: 'Deep proficiency across containers, orchestration, service meshes, serverless, and cloud-native design patterns at enterprise scale.' },
  { title: 'AI Expertise', desc: 'Practical AI engineering experience spanning LLM applications, retrieval-augmented generation, model evaluation, AI infrastructure, and enterprise AI governance.' },
  { title: 'Data Expertise', desc: 'End-to-end data engineering capability: warehouses, lakes, streaming, data mesh, governance, and analytics at production scale.' },
  { title: 'Security-Focused Approach', desc: 'Security treated as an architectural property, not a checklist. Assessments evaluate zero-trust maturity, policy-as-code, and compliance automation.' },
  { title: 'Actionable Recommendations', desc: 'Every finding is paired with a specific recommendation, estimated effort, expected impact, and clear ownership. We do not deliver reports that sit on shelves.' },
  { title: 'Knowledge Transfer', desc: 'Findings and recommendations are presented in language your team understands. We invest in helping your organization build the capability to act on the assessment independently.' },
  { title: 'Long-Term Partnership', desc: 'The assessment is designed as the beginning of a relationship, not a transaction. Many organizations continue to engage Substrate for implementation, advisory, and ongoing partnership.' },
];

const faqItems = [
  { q: 'How long does an Engineering Discovery & Assessment typically take?', a: 'Assessment duration depends on organizational complexity. A focused engagement for a single business unit typically runs 3–4 weeks. Enterprise-wide assessments spanning multiple divisions and geographies typically require 6–8 weeks. We provide a precise timeline after the kickoff call.' },
  { q: 'What deliverables will we receive?', a: 'Deliverables include an Executive Summary, Technology Landscape Assessment, Architecture Review, Engineering Maturity Score, Capability Maturity Matrix, SWOT Analysis, Technical Debt Report, Cloud Assessment, Security Findings, Risk Register, Prioritized Roadmap, Investment Recommendations, Architecture Diagrams, and an Executive Presentation. The full list is documented in the deliverables section.' },
  { q: 'How do you price an assessment engagement?', a: 'Assessment engagements are typically priced as fixed-fee projects based on scope, duration, and organizational complexity. We provide a transparent, itemized proposal after an initial discovery call. Pricing reflects the depth of analysis, number of stakeholder interviews, and volume of systems reviewed.' },
  { q: 'Will the assessment require access to sensitive systems and data?', a: 'Access requirements depend on the scope of assessment. We respect your security boundaries and work with your team to determine the minimum access necessary. All findings can be produced through documentation review, stakeholder interviews, and non-invasive analysis. Where deeper access provides significantly better recommendations, we discuss the approach and agree on boundaries before proceeding.' },
  { q: 'Do you sign NDAs before the engagement begins?', a: 'Yes. We routinely sign mutual NDAs before beginning any assessment. We treat all client information — including the existence of the engagement itself — as confidential. Our standard NDA can be executed within 24 hours.' },
  { q: 'Can the assessment be conducted remotely?', a: 'Yes. The majority of our assessments are conducted remotely using secure video conferencing, collaborative documentation tools, and asynchronous communication. Remote assessments are our standard delivery model and do not compromise the depth or quality of analysis.' },
  { q: 'Do you offer on-site workshops?', a: 'We offer on-site workshops for organizations that prefer in-person collaboration. Key milestones — kickoff, stakeholder interviews, and the executive presentation — often benefit from on-site presence. On-site delivery is available for organizations in our operating regions and can be arranged for other locations.' },
  { q: 'What technology environments can you assess?', a: 'We assess all major technology environments: cloud-native (AWS, Azure, GCP), on-premises, hybrid, multi-cloud, containerized, serverless, and traditional data center architectures. Our team has experience across the full spectrum of enterprise technology stacks.' },
  { q: 'Which cloud platforms do you cover?', a: 'We maintain deep expertise across AWS, Azure, and Google Cloud Platform. Our assessment evaluates your cloud architecture regardless of provider. We also assess multi-cloud and hybrid cloud strategies.' },
  { q: 'Do you assess AI readiness?', a: 'Yes. AI readiness assessment is a standard component. We evaluate model infrastructure, training and inference pipelines, evaluation frameworks, prompt engineering practices, AI governance, data readiness for AI, and the organizational capability to develop and operate AI systems responsibly.' },
  { q: 'What does an architecture review cover?', a: 'Architecture review covers system boundaries, service decomposition, integration patterns, data flow, failure modes, scalability characteristics, security architecture, compliance alignment, and architectural governance. We review both the intended architecture (documentation, diagrams, ADRs) and the actual architecture (code, configuration, runtime behavior).' },
  { q: 'Who participates in the executive presentation?', a: 'The executive presentation is designed for senior leadership: CIO, CTO, CDO, VP Engineering, Engineering Directors, and other stakeholders you designate. The presentation summarizes strategic findings, prioritized recommendations, investment requirements, and expected business outcomes. We typically allocate 60–90 minutes for this session.' },
  { q: 'How does this differ from a traditional IT audit?', a: 'A traditional IT audit measures compliance against a standard framework (SOX, PCI-DSS, ISO 27001). Our assessment goes deeper: we evaluate engineering practices, architecture quality, operational maturity, team capability, and strategic alignment. The output is not a compliance checklist but an actionable modernization roadmap with prioritized investments and expected business outcomes.' },
  { q: 'How does this differ from a consulting engagement focused on implementation?', a: 'Implementation-focused engagements begin with a solution. Our assessment begins with understanding. We do not recommend any technology or approach until we have thoroughly evaluated your current state, business context, and constraints. The assessment is intentionally vendor-neutral and solution-agnostic. Recommendations emerge from evidence, not from a pre-defined service offering.' },
  { q: 'What happens after the assessment is delivered?', a: 'After delivery, we schedule an executive review to walk through findings and recommendations. Many organizations choose to engage Substrate for implementation support on the highest-priority initiatives. Others implement recommendations with their own teams and retain Substrate for periodic advisory or check-point assessments. The assessment includes a follow-up review at 3 months and 12 months post-delivery to evaluate progress.' },
  { q: 'Can you support implementation of the recommendations?', a: 'Yes. If your organization requires implementation support, Substrate offers a full range of engineering services aligned to the assessment findings: platform engineering, cloud architecture, AI-native engineering, data engineering, SRE, enterprise architecture, and application modernization. Implementation is always optional and separately scoped.' },
  { q: 'Do you offer follow-up assessments to measure progress?', a: 'Yes. We recommend a follow-up assessment 12 months after the initial engagement to measure progress, reassess priorities, and update the roadmap. Many organizations establish a regular cadence of annual or bi-annual assessments as part of their continuous improvement program.' },
  { q: 'How do you ensure findings are objective?', a: 'Objectivity is built into our methodology. Findings are based on documented evidence, not subjective opinion. Every assessment is conducted by engineers who are not involved in subsequent implementation work. We cross-reference findings across multiple data sources (documentation, interviews, configuration, telemetry) to ensure accuracy.' },
  { q: 'What is the team composition for an assessment engagement?', a: 'A typical assessment team includes a Lead Architect, a Delivery Lead, and domain specialists as needed (cloud architect, security engineer, data engineer, AI engineer). The team is sized according to the scope and complexity of the engagement. Every engagement is led by a senior engineer with at least 15 years of industry experience.' },
  { q: 'Can the assessment scope be adjusted after kickoff?', a: 'Yes. The first phase of every assessment is a calibration period during which we validate the scope and adjust if new information suggests a different focus area would deliver more value. We provide weekly updates and maintain flexibility to adapt to emerging findings.' },
  { q: 'What size organizations is this assessment designed for?', a: 'The assessment methodology is designed for organizations with 50 to 50,000+ employees. We adapt the depth and breadth of the assessment to organizational complexity. A focused assessment for a single business unit is ideal for mid-sized organizations. Enterprise-wide assessments serve large, multi-division organizations.' },
  { q: 'Do you work with startups and scale-ups?', a: 'Yes. While the assessment methodology was designed for established enterprises, we regularly work with growth-stage companies (Series A and beyond) that are experiencing scaling challenges and need architectural guidance before technical debt compounds.' },
  { q: 'How is the assessment structured for multi-division organizations?', a: 'For multi-division organizations, we typically conduct a tiered assessment: an organization-wide strategic assessment followed by deeper dives into specific divisions or business units identified as priority areas. This approach balances breadth with depth.' },
  { q: 'What is the engagement model for ongoing advisory after the assessment?', a: 'Post-assessment advisory is typically structured as a retainer engagement with a defined scope of work: regular architecture reviews, strategic guidance, technology evaluation support, and periodic check-point assessments. Retainers are typically 2–5 days per month with flexibility to scale up for specific initiatives.' },
];

const maturityLevels = [
  { level: '1', name: 'Reactive', desc: 'Work is delivered through individual heroics rather than repeatable processes. Incidents are handled ad-hoc. Architecture is undocumented and evolves by accretion. Testing is minimal or absent. Deployments are manual, infrequent, and high-risk. Technical debt accumulates without visibility or governance.', color: 'var(--c-ink-3)' },
  { level: '2', name: 'Standardized', desc: 'Repeatable processes are defined and followed across teams. CI/CD pipelines exist but may have gaps. Testing coverage improves. Architecture documentation is maintained. Monitoring is in place but may not be comprehensive. Change management processes reduce deployment risk.', color: 'var(--c-ink-2)' },
  { level: '3', name: 'Automated', desc: 'Infrastructure is managed as code. Deployments are automated and frequent. Testing is integrated into pipelines. Observability provides production insight. Security practices are automated. Teams have clear ownership. Technical debt is tracked and managed.', color: 'var(--c-accent)' },
  { level: '4', name: 'Platform Driven', desc: 'An internal developer platform provides golden paths, self-service infrastructure, and paved roads to production. Developer experience is a first-class concern. Platform teams treat their platform as a product. Engineering velocity is measured and optimized. Cross-team collaboration is enabled by platform abstractions.', color: 'var(--c-accent-bright)' },
  { level: '5', name: 'AI-Native Enterprise', desc: 'AI is integrated into engineering workflows, operational processes, and product capabilities. Models are treated as software artifacts with evaluation, testing, and monitoring. AI infrastructure is platform-managed. Organizations ship AI features with the same rigor as traditional software. Architecture decisions account for AI workload characteristics. Governance frameworks ensure responsible AI operation.', color: '#ffffff' },
];

const outcomes = [
  { stat: 'Reduced Operational Risk', desc: 'Identify and mitigate risks before they cause incidents. Lower mean time to detect (MTTD) and mean time to resolve (MTTR).' },
  { stat: 'Lower Cloud Costs', desc: 'Eliminate wasted spend through right-sizing, reserved instance optimization, storage lifecycle management, and FinOps practice maturity.' },
  { stat: 'Higher Developer Productivity', desc: 'Reduce friction in the engineering workflow. Faster feedback loops, improved tooling, and clearer development paths.' },
  { stat: 'Improved Software Delivery', desc: 'Faster deployment frequency, shorter lead time for changes, higher change success rate, and faster recovery from failures.' },
  { stat: 'Better Governance', desc: 'Clear architectural decision-making, consistent standards enforcement, automated compliance verification, and auditable change management.' },
  { stat: 'Improved Reliability', desc: 'Higher service availability, predictable performance, effective incident response, and measurable reliability through SLOs.' },
  { stat: 'Reduced Technical Debt', desc: 'Quantified technical debt with a prioritized remediation plan. Prevent accumulation through improved engineering practices and architectural governance.' },
  { stat: 'Greater Business Agility', desc: 'Faster time-to-market for new capabilities. Ability to respond to market changes without being constrained by technology limitations.' },
  { stat: 'Higher Security Posture', desc: 'Identified and remediated vulnerabilities. Improved security architecture. Automated security verification. Reduced attack surface.' },
  { stat: 'AI Readiness', desc: 'Clear understanding of AI opportunities and requirements. Readiness assessment for AI adoption. Foundation for responsible AI implementation.' },
  { stat: 'Scalable Architecture', desc: 'Architecture designed for growth: traffic, data volume, team size, and organizational complexity. Eliminated scaling bottlenecks.' },
  { stat: 'Executive Visibility', desc: 'Clear, measurable understanding of the technology organization\'s current state, trajectory, and investment requirements. Data-driven decision-making.' },
];
---

<Base
  title="Engineering Discovery & Assessment | Substrate"
  description="Substrate's Engineering Discovery & Assessment evaluates your technology landscape, identifies opportunities, and delivers an evidence-based roadmap for modernization and growth."
>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden py-24 md:py-40" aria-labelledby="hero-heading">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--c-accent-soft)_0%,_transparent_60%)] pointer-events-none" aria-hidden="true" />
    <div class="container-x relative z-10">
      <nav class="mb-10 text-sm text-ink-3">
        {breadcrumbs.map((crumb, idx) => (
          <span>
            {idx > 0 && ' / '}
            {crumb.href && idx < breadcrumbs.length - 1
              ? <a href={crumb.href} class="text-accent hover:underline">{crumb.name}</a>
              : <span class={idx === breadcrumbs.length - 1 ? 'font-medium text-ink' : ''}>{crumb.name}</span>
            }
          </span>
        ))}
      </nav>

      <div class="max-w-4xl" data-reveal-group>
        <p class="kicker text-accent mb-5" data-reveal>
          <span class="text-accent">00</span><span aria-hidden="true">&nbsp;—&nbsp;</span>Engineering Discovery & Assessment
        </p>
        <h1 id="hero-heading" class="display text-5xl md:text-[4.5rem] text-ink max-w-5xl" data-reveal>
          Understand where you are before you decide where to go.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-ink-2 max-w-2xl leading-relaxed" data-reveal>
          Every successful engineering initiative begins with an honest understanding of the current state. 
          Substrate's Engineering Discovery & Assessment evaluates your technology landscape, identifies 
          opportunities for improvement, and delivers an evidence-based roadmap for modernization and growth.
        </p>
        <p class="mt-4 text-lg md:text-xl text-ink-2 max-w-2xl leading-relaxed" data-reveal>
          We do not sell implementation services first. We help you understand where you are today, 
          what needs to change, and what to do about it — before any investment decisions are made.
        </p>
        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <Button href="/contact" variant="primary" size="md">Schedule an assessment</Button>
          <Button href="#what-we-assess" variant="secondary" size="md">View assessment scope</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. WHY START WITH AN ASSESSMENT -->
  <section class="py-20 md:py-28 bg-paper-2" aria-labelledby="why-assess-heading">
    <div class="container-x">
      <SectionHeading
        id="why-assess-heading"
        index="01"
        label="Why Start With an Assessment"
        title="Most organizations do not know what they do not know."
        lede="Technology investments made without understanding the current state are bets, not strategies. An assessment surfaces the hidden realities that determine whether modernization succeeds or fails."
      />

      <div class="mt-14 grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {[
          'Hidden technical debt that compounds daily',
          'Unknown operational risks in critical systems',
          'Inefficient engineering processes slowing delivery',
          'Misaligned technology investments that miss business objectives',
          'Lack of architectural visibility across the organization',
          'Increasing cloud costs without corresponding value',
          'Scaling challenges that emerge under growth',
          'AI readiness gaps that limit competitive options',
          'Security gaps invisible to existing monitoring',
          'Compliance concerns with regulatory exposure',
        ].map((item, i) => (
          <div class="flex items-start gap-3 p-4 rounded-lg border border-line bg-paper" data-reveal>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">{(i + 1).toString().padStart(2, '0')}</span>
            <p class="text-sm text-ink-2 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. WHAT IS AN ENGINEERING DISCOVERY & ASSESSMENT -->
  <section class="py-20 md:py-28" aria-labelledby="what-is-heading">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal-group>
        <p class="kicker text-accent mb-5" data-reveal>
          <span class="text-accent">02</span><span aria-hidden="true">&nbsp;—&nbsp;</span>What This Is
        </p>
        <h2 id="what-is-heading" class="display text-4xl md:text-5xl text-ink" data-reveal>
          Not an audit. Not a sales pitch. A forensic engineering evaluation.
        </h2>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 max-w-5xl" data-reveal-group>
        <div data-reveal>
          <h3 class="font-display font-semibold text-lg text-ink mb-3">Purpose</h3>
          <p class="text-ink-2 leading-relaxed text-sm">
            The Engineering Discovery & Assessment exists to give organizations a complete, 
            honest picture of their technology landscape before making investment decisions. 
            It surfaces what is working, what is not, what is risky, and what is ready for change.
          </p>
        </div>
        <div data-reveal>
          <h3 class="font-display font-semibold text-lg text-ink mb-3">Business Value</h3>
          <p class="text-ink-2 leading-relaxed text-sm">
            Organizations gain clarity on where their technology investments are delivering 
            returns and where they are accumulating cost or risk. The assessment replaces 
            assumptions with evidence, enabling confident decision-making at the executive level.
          </p>
        </div>
        <div data-reveal>
          <h3 class="font-display font-semibold text-lg text-ink mb-3">Engineering Value</h3>
          <p class="text-ink-2 leading-relaxed text-sm">
            Engineering teams gain a shared understanding of their architecture, practices, 
            and constraints. The assessment provides a common vocabulary for discussing 
            improvement priorities and a measurable baseline against which progress is tracked.
          </p>
        </div>
        <div data-reveal>
          <h3 class="font-display font-semibold text-lg text-ink mb-3">Expected Outcomes</h3>
          <p class="text-ink-2 leading-relaxed text-sm">
            A prioritized roadmap with clear initiatives, estimated effort, expected impact, 
            and investment requirements. Organizations leave the assessment with confidence 
            about what to do next — and what not to do.
          </p>
        </div>
      </div>

      <div class="mt-16 grid gap-6 md:grid-cols-2 max-w-4xl" data-reveal-group>
        <div class="border-l-2 border-accent pl-5 py-3" data-reveal>
          <p class="font-display font-semibold text-ink mb-1">Not an IT audit</p>
          <p class="text-sm text-ink-2 leading-relaxed">
            An IT audit measures compliance against standards. Our assessment evaluates engineering 
            maturity, architecture quality, operational effectiveness, and strategic alignment. 
            The output is a roadmap, not a checklist.
          </p>
        </div>
        <div class="border-l-2 border-accent pl-5 py-3" data-reveal>
          <p class="font-display font-semibold text-ink mb-1">Not an implementation pitch</p>
          <p class="text-sm text-ink-2 leading-relaxed">
            Implementation-focused engagements begin with a solution. We begin with understanding. 
            No technology or approach is recommended until we have thoroughly evaluated your 
            current state, business context, and constraints.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. WHAT WE ASSESS -->
  <section class="py-20 md:py-28 bg-paper-2" id="what-we-assess" aria-labelledby="assess-heading">
    <div class="container-x">
      <SectionHeading
        id="assess-heading"
        index="03"
        label="What We Assess"
        title="Thirty-three capability areas. One comprehensive view."
        lede="We evaluate the full breadth of your technology organization — from strategy and architecture to engineering practices and operational maturity. Every dimension is assessed against industry standards and real-world production experience."
      />

      <div class="mt-14 grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {assessCards.map((card, i) => (
          <div class="p-4 rounded-lg border border-line bg-paper transition-colors duration-200 hover:border-accent/20" data-reveal>
            <span class="kicker text-accent text-[0.7rem]">{(i + 1).toString().padStart(2, '0')}</span>
            <h3 class="font-display font-semibold text-sm text-ink mt-1 mb-1">{card.title}</h3>
            <p class="text-xs text-ink-2 leading-relaxed">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. ASSESSMENT METHODOLOGY -->
  <section class="py-20 md:py-28" aria-labelledby="methodology-heading">
    <div class="container-x">
      <SectionHeading
        id="methodology-heading"
        index="04"
        label="Methodology"
        title="Fifteen phases. One repeatable process."
        lede="Every assessment follows the same rigorous methodology. The structure ensures consistency across engagements while adapting to the specific context of your organization."
      />

      <div class="mt-14 space-y-3" data-reveal-group>
        {phases.map((phase, i) => (
          <details class="group rounded-lg border border-line bg-paper overflow-hidden transition-colors duration-200 hover:border-accent/20" data-reveal>
            <summary class="flex items-center gap-4 p-4 cursor-pointer list-none select-none">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">{(i + 1).toString().padStart(2, '0')}</span>
              <span class="font-display font-semibold text-ink text-sm">{phase.name}</span>
              <svg class="ml-auto w-4 h-4 text-ink-3 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </summary>
            <div class="px-4 pb-4 pt-0">
              <div class="ml-11">
                <p class="text-xs text-ink-2 leading-relaxed">{phase.desc}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. DELIVERABLES -->
  <section class="py-20 md:py-28 bg-paper-2" aria-labelledby="deliverables-heading">
    <div class="container-x">
      <SectionHeading
        id="deliverables-heading"
        index="05"
        label="Deliverables"
        title="Nineteen documents. Every finding supported by evidence."
        lede="Each assessment produces a comprehensive set of deliverables designed for different audiences — from board-level executives to engineering teams. Every document is written to be acted upon, not archived."
      />

      <div class="mt-14 grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {deliverables.map((d, i) => (
          <div class="p-4 rounded-lg border border-line bg-paper" data-reveal>
            <span class="kicker text-accent text-[0.7rem]">{(i + 1).toString().padStart(2, '0')}</span>
            <h3 class="font-display font-semibold text-sm text-ink mt-1 mb-1">{d.name}</h3>
            <p class="text-xs text-ink-2 leading-relaxed">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. ASSESSMENT FRAMEWORK (MATURITY MODEL) -->
  <section class="py-20 md:py-28" aria-labelledby="framework-heading">
    <div class="container-x">
      <SectionHeading
        id="framework-heading"
        index="06"
        label="Maturity Framework"
        title="Five levels of engineering maturity."
        lede="We assess your organization against a five-level maturity model adapted from industry standards and refined through hundreds of enterprise engagements. Each capability area is independently rated."
      />

      <div class="mt-14 space-y-0" data-reveal-group>
        {maturityLevels.map((m, i) => (
          <div class="flex items-stretch border-b border-line last:border-b-0" data-reveal>
            <div class="flex w-16 md:w-20 shrink-0 items-center justify-center border-r border-line" style={`background: ${i === 4 ? 'var(--c-graphite)' : 'transparent'}; ${i === 4 ? 'color: white;' : ''}`}>
              <span class="font-display text-2xl font-bold" style={`color: ${i === 4 ? '#ffffff' : m.color}`}>{m.level}</span>
            </div>
            <div class={`flex-1 p-4 md:p-5 ${i === 4 ? 'bg-graphite text-graphite-fg rounded-r-lg' : ''}`}>
              <h3 class="font-display font-semibold text-sm text-ink mb-1" style={i === 4 ? 'color: #eaecf1' : ''}>{m.name}</h3>
              <p class="text-xs leading-relaxed" style={`color: ${i === 4 ? 'var(--c-graphite-fg-2)' : 'var(--c-ink-2)'}`}>{m.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 p-5 rounded-lg border border-line bg-paper-2" data-reveal>
        <p class="font-display font-semibold text-sm text-ink mb-2">Recommended visualization</p>
        <p class="text-xs text-ink-2 leading-relaxed">
          Render the maturity model as a horizontal bar segmented into five color-coded sections 
          progressing from dark gray (Level 1) through accent blue (Level 3) to bright accent 
          (Level 4) and white-on-dark (Level 5). Each capability area is plotted as a marker on 
          this bar, creating a visual radar of organizational maturity. An interactive version 
          allows stakeholders to filter by capability group (engineering, architecture, operations, 
          security, data) and compare current-state against target-state maturity.
        </p>
      </div>
    </div>
  </section>

  <!-- 8. BUSINESS OUTCOMES -->
  <section class="py-20 md:py-28 bg-paper-2" aria-labelledby="outcomes-heading">
    <div class="container-x">
      <SectionHeading
        id="outcomes-heading"
