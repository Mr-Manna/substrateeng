            <p class="text-xs text-ink-2 leading-relaxed flex-1">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. INDUSTRIES -->
  <section class="py-20 md:py-28 bg-paper-2" aria-labelledby="industries-heading">
    <div class="container-x">
      <SectionHeading
        id="industries-heading"
        index="09"
