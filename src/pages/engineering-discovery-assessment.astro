            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display font-semibold text-sm text-ink mb-1">{r.title}</h3>
              <p class="text-xs text-ink-2 leading-relaxed">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
