---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Capabilities', href: '/#capabilities' },
  { name: 'Platform Engineering', href: '' },
];
---

<Base
  title="Platform Engineering Services | Substrate"
  description="Substrate helps enterprises build internal developer platforms with golden paths, self-service infrastructure, and paved roads to production. Accelerate delivery, reduce complexity, and scale engineering."
>
<!-- ============================================================ -->
<!-- 1. HERO -->
<!-- ============================================================ -->
<section class="relative overflow-hidden py-24 md:py-40" aria-labelledby="hero-heading">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--c-accent-soft)_0%,_transparent_60%)] pointer-events-none" aria-hidden="true" />
  <div class="container-x relative z-10">
    <nav class="mb-10 text-sm text-ink-3">
      {breadcrumbs.map((crumb, idx) => (
        <span>
          {idx > 0 && ' / '}
          {crumb.href && idx < breadcrumbs.length - 1
            ? <a href={crumb.href} class="text-accent hover:underline">{crumb.name}</a>
            : <span class={idx === breadcrumbs.length - 1 ? 'font-medium text-ink' : ''}>{crumb.name}</span>
          }
        </span>
      ))}
    </nav>

    <div class="max-w-4xl" data-reveal-group>
      <p class="kicker text-accent mb-5" data-reveal>
        <span class="text-accent">01</span><span aria-hidden="true">&nbsp;—&nbsp;</span>Platform Engineering
      </p>
      <h1 id="hero-heading" class="display text-5xl md:text-[4.5rem] text-ink max-w-5xl" data-reveal>
        Ship software faster,<br />operate with less friction.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-ink-2 max-w-2xl leading-relaxed" data-reveal>
        Platform engineering is the practice of building internal developer platforms that reduce cognitive load, standardize infrastructure, and let engineering teams focus on what matters: delivering value to customers.
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal>
        <Button href="/contact" variant="primary" size="md">Talk to our team</Button>
        <Button href="#what-is" variant="secondary" size="md">Learn more</Button>
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3 max-w-4xl" data-reveal-group>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">60-80%</p>
        <p class="text-sm text-ink-2 mt-1">Fewer environment-related incidents with standardized platforms</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">3-5x</p>
        <p class="text-sm text-ink-2 mt-1">Faster deployment frequency with self-service infrastructure</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">40%</p>
        <p class="text-sm text-ink-2 mt-1">Reduction in cloud infrastructure costs through governance and standardization</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 2. WHAT IS PLATFORM ENGINEERING? -->
<!-- ============================================================ -->
<section id="what-is" class="py-20 md:py-28 bg-graphite" aria-labelledby="whatis-heading">
  <div class="container-x">
    <SectionHeading
      id="whatis-heading"
      index="02"
      label="What is Platform Engineering"
      title="An internal product that makes your engineering organization more efficient."
      lede="Platform engineering is the discipline of designing and building internal developer platforms that provide self-service capabilities, standardized infrastructure, and paved paths to production. It treats the platform as a product, with the engineering organization as its customer."
      tone="graphite"
    />

    <div class="mt-14 grid gap-10 md:grid-cols-2 lg:gap-16" data-reveal-group>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">What it is</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          A platform is a curated set of tools, services, and workflows that developers use to build, deploy, and operate software. It abstracts away infrastructure complexity, enforces organizational standards, and provides self-service access to everything a team needs to go from idea to production.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          The platform team builds and maintains this layer. Application teams consume it. The result is consistent, secure, and fast software delivery across the entire organization.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Why companies adopt it</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          As engineering organizations grow, the ad hoc approach of each team managing its own infrastructure becomes unsustainable. Platform engineering provides a single source of truth for infrastructure, deployment, and operations. It reduces duplication, enforces security and compliance, and lets application teams move faster.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          Organizations that adopt platform engineering see measurable improvements in deployment frequency, lead time, mean time to recovery, and developer satisfaction.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Platform engineering vs. DevOps</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          DevOps is a cultural and operational philosophy focused on breaking down silos between development and operations. Platform engineering is an implementation discipline that builds the tools and systems to make that philosophy practical at scale.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          Think of it this way: DevOps defines the <em>what</em> and <em>why</em>. Platform engineering delivers the <em>how</em>. The best platform engineering organizations are built on a strong DevOps culture.
        </p>
      </div>

      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Common misconceptions</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">A platform is not a single tool.</strong> It is a cohesive system of tools, processes, and documentation.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">Platform engineering is not a product purchase.</strong> It requires organizational change, not just a software license.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">Platforms do not slow developers down.</strong> Well-designed platforms accelerate delivery by removing decisions and friction.</span>
          </li>
          <li class="flex items-start gap-3 text-graphite-fg-2">
            <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
            <span><strong class="text-graphite-fg">It is not just for large enterprises.</strong> Any organization with multiple teams or services benefits from platform thinking.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 3. BUSINESS CHALLENGES -->
<!-- ============================================================ -->
<section class="py-20 md:py-28" aria-labelledby="challenges-heading">
  <div class="container-x">
    <SectionHeading
      id="challenges-heading"
      index="03"
      label="Business Challenges"
      title="The operational debt of unmanaged complexity."
      lede="Before investing in platform engineering, most organizations face a similar set of structural problems that slow delivery, increase costs, and frustrate teams."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">01</span>
          <h3 class="font-display font-semibold text-ink">Slow software delivery</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Every team reinvents infrastructure, pipelines, and deployment processes. Velocity is lost to duplication and manual effort.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">02</span>
          <h3 class="font-display font-semibold text-ink">Manual infrastructure</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Environments are provisioned by hand, leading to configuration drift, long setup times, and human error in production.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">03</span>
          <h3 class="font-display font-semibold text-ink">Developer bottlenecks</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Operations and infrastructure teams become a blocker. Developers wait days or weeks for environments, access, and deployments.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">04</span>
          <h3 class="font-display font-semibold text-ink">Inconsistent environments</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Developer, staging, and production environments diverge. The classic "works on my machine" problem scales across every team.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">05</span>
          <h3 class="font-display font-semibold text-ink">Cloud cost growth</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Without governance, cloud spending grows faster than revenue. Orphaned resources, over-provisioned instances, and unused capacity accumulate.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">06</span>
          <h3 class="font-display font-semibold text-ink">Security risks</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Credential sprawl, unpatched dependencies, and ad hoc network policies create attack surfaces that compliance teams cannot fully audit.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">07</span>
          <h3 class="font-display font-semibold text-ink">Operational complexity</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Incident response is chaotic without standardized runbooks, observability, and alerting. On-call engineers lack the context to resolve issues quickly.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">08</span>
          <h3 class="font-display font-semibold text-ink">Scaling difficulties</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">The practices that work for 20 engineers break at 100. What worked at 100 fails at 500. Infrastructure and processes do not scale linearly.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">09</span>
          <h3 class="font-display font-semibold text-ink">Knowledge silos</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Critical infrastructure knowledge lives in individuals, not documentation. Bus factor is high. Onboarding new engineers takes months.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 4. HOW SUBSTRATE HELPS -->
<!-- ============================================================ -->
<section class="py-20 md:py-28 bg-graphite" aria-labelledby="approach-heading">
  <div class="container-x">
    <SectionHeading
      id="approach-heading"
      index="04"
      label="How Substrate Helps"
      title="A systematic approach to platform engineering."
      lede="We do not sell a product or prescribe a single methodology. We work with your organization to design, build, and operate a platform that fits your technical landscape, team structure, and business goals."
      tone="graphite"
    />

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">01</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Platform Assessment</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Audit existing toolchains, workflows, pain points, and team capabilities. We produce a platform maturity assessment with prioritized recommendations.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">02</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Platform Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define the platform vision, scope, adoption model, and roadmap. We align stakeholders around what the platform will and will not include.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">03</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Platform Design</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Architect the platform's technical foundation: APIs, abstractions, interfaces, security boundaries, and integration points with existing systems.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">04</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Developer Experience</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Design the interfaces developers interact with: CLI tools, portals, documentation, and APIs. We prioritize clarity, speed, and discoverability.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">05</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Automation</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Eliminate manual processes through infrastructure as code, CI/CD pipelines, automated testing, and policy enforcement. Reduce toil, increase reliability.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">06</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Self-Service Platforms</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Empower teams to provision environments, deploy services, and manage dependencies without opening a ticket. Guardrails, not gatekeeping.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">07</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Golden Paths</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define and maintain paved roads for common workflows: creating a service, deploying to production, configuring observability, and rotating credentials.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">08</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Internal Developer Platforms</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Build the integrated platform layer that combines IDP components, developer portals, IaC modules, and observability into a single cohesive experience.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">09</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Observability</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Instrument everything: metrics, traces, logs. Establish SLOs, dashboards, and alerting so teams understand system health and can respond to issues.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">10</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Security</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Embed security into the platform: secrets management, policy as code, network policies, vulnerability scanning, and compliance automation from day one.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">11</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Infrastructure as Code</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Manage all infrastructure through version-controlled, tested, and reusable code modules. Environments are reproducible, auditable, and disposable.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">12</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Continuous Improvement</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Platforms are never finished. We establish feedback loops, adoption metrics, and iteration cycles to keep the platform aligned with evolving team needs.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 5. PLATFORM ENGINEERING SERVICES -->
<!-- ============================================================ -->
<section class="py-20 md:py-28" aria-labelledby="services-heading">
  <div class="container-x">
    <SectionHeading
      id="services-heading"
      index="05"
      label="Our Services"
      title="End-to-end platform engineering capabilities."
      lede="From strategy through operations, we provide the full range of services needed to design, build, and run internal developer platforms at enterprise scale."
    />

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Platform Strategy</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Define your platform vision, scope, operating model, and adoption roadmap. We align technology decisions with business objectives and engineering culture.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Current state assessment</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Platform maturity model</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> 12-month phased roadmap</li>
        </ul>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Developer Platforms</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Design and build integrated platforms that combine compute, storage, networking, and developer tooling into a cohesive, self-service experience.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Platform architecture design</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> API and abstraction layer</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Reference implementations</li>
        </ul>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Internal Developer Platform</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Build a comprehensive IDP that provides golden paths, self-service infrastructure, and paved roads for every stage of the software delivery lifecycle.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Backstage or custom portal</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Service catalog &amp; templates</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Tech docs &amp; scorecards</li>
        </ul>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Infrastructure as Code</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Implement IaC practices across your entire infrastructure footprint. Terraform, Pulumi, CDK, or Cloud Formation modules that are tested, versioned, and reusable.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Module registry &amp; publishing</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> State management &amp; locking</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Drift detection &amp; remediation</li>
        </ul>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Kubernetes Platforms</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Design, deploy, and operate Kubernetes clusters as a platform. Multi-cluster management, service mesh, ingress, policy engines, and cost allocation built in.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Cluster architecture &amp; bootstrap</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Tenant isolation &amp; namespaces</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Upgrade &amp; lifecycle management</li>
