---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Capabilities', href: '/#capabilities' },
  { name: 'Enterprise Architecture', href: '' },
];
---

<Base
  title="Enterprise Architecture Services | Substrate"
  description="Substrate helps enterprises design technology strategies, modernize legacy systems, and build scalable digital platforms through modern Enterprise Architecture. TOGAF, ArchiMate, and business-driven architecture."
>


<!-- 1. HERO -->
<section class="relative overflow-hidden py-24 md:py-40" aria-labelledby="hero-heading">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--c-accent-soft)_0%,_transparent_60%)] pointer-events-none" aria-hidden="true" />
  <div class="container-x relative z-10">
    <nav class="mb-10 text-sm text-ink-3">
      {breadcrumbs.map((crumb, idx) => (
        <span>
          {idx > 0 && ' / '}
          {crumb.href && idx < breadcrumbs.length - 1
            ? <a href={crumb.href} class="text-accent hover:underline">{crumb.name}</a>
            : <span class={idx === breadcrumbs.length - 1 ? 'font-medium text-ink' : ''}>{crumb.name}</span>
          }
        </span>
      ))}
    </nav>
    <div class="max-w-4xl" data-reveal-group>
      <p class="kicker text-accent mb-5" data-reveal>
        <span class="text-accent">01</span><span aria-hidden="true">&nbsp;—&nbsp;</span>Enterprise Architecture
      </p>
      <h1 id="hero-heading" class="display text-5xl md:text-[4.5rem] text-ink max-w-5xl" data-reveal>
        Align technology strategy<br />with business outcomes.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-ink-2 max-w-2xl leading-relaxed" data-reveal>
        Enterprise Architecture is the discipline of translating business strategy into technology execution. Substrate helps organizations design enterprise-wide architectures that improve agility, reduce complexity, strengthen governance, and enable sustainable digital transformation.
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal>
        <Button href="/contact" variant="primary" size="md">Schedule a strategy workshop</Button>
        <Button href="#what-is" variant="secondary" size="md">Learn more</Button>
      </div>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-3 max-w-4xl" data-reveal-group>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">40%</p>
        <p class="text-sm text-ink-2 mt-1">Reduction in IT operating costs through portfolio rationalization and application consolidation</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">3x</p>
        <p class="text-sm text-ink-2 mt-1">Faster technology change delivery with clear architecture roadmaps and governed standards</p>
      </div>
      <div class="border-t border-line pt-5" data-reveal>
        <p class="text-3xl font-display font-semibold text-accent">60%</p>
        <p class="text-sm text-ink-2 mt-1">Fewer integration failures with standardized APIs, event-driven architectures, and governed interfaces</p>
      </div>
    </div>
  </div>
</section>

<!-- 2. WHAT IS ENTERPRISE ARCHITECTURE? -->
<section id="what-is" class="py-20 md:py-28 bg-graphite" aria-labelledby="whatis-heading">
  <div class="container-x">
    <SectionHeading
      id="whatis-heading"
      index="02"
      label="What is Enterprise Architecture"
      title="The connective tissue between business strategy and technology execution."
      lede="Enterprise Architecture provides a structured framework for aligning business capabilities, processes, data, applications, and technology with organizational strategy. It is the practice of designing, governing, and evolving the enterprise technology ecosystem as a coherent system rather than a collection of independent projects."
      tone="graphite"
    />
    <div class="mt-14 grid gap-10 md:grid-cols-2 lg:gap-16" data-reveal-group>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Definition and purpose</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Enterprise Architecture is the practice of analyzing, designing, planning, and governing the enterprise technology ecosystem to ensure it supports business strategy and delivers measurable outcomes. It provides a holistic view of the organization's capabilities, processes, applications, data, and infrastructure, and establishes the standards, principles, and roadmaps that guide technology decisions.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          The purpose of Enterprise Architecture is to reduce complexity, eliminate redundancy, improve integration, strengthen governance, and accelerate change. It ensures that every technology investment is justified by strategic business value and that the enterprise technology portfolio remains coherent, manageable, and aligned with long-term goals.
        </p>
      </div>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Why Enterprise Architecture matters</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Organizations without effective Enterprise Architecture accumulate technical debt, duplicate systems, inconsistent standards, and integration bottlenecks. Digital transformation initiatives stall. Cloud migrations exceed budgets. Security vulnerabilities persist. Business units bypass IT. IT costs grow faster than revenue.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          Enterprise Architecture addresses these problems by providing the strategic context, governance structures, and technical standards that enable organizations to make consistent, informed technology decisions. It transforms IT from a cost center to a strategic enabler of business outcomes.
        </p>
      </div>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Enterprise Architecture vs. Solution Architecture</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Enterprise Architecture operates at the level of the entire organization, defining the strategic technology direction, standards, and principles that guide all technology decisions. Solution Architecture operates at the level of individual projects or solutions, designing the specific architecture for a given business problem within the enterprise context.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          Enterprise Architecture establishes the "why" and "what." Solution Architecture establishes the "how." Enterprise Architects define the technology landscape and governance. Solution Architects design systems that fit within that landscape.
        </p>
      </div>
      <div data-reveal>
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Enterprise Architecture vs. Software Architecture</h3>
        <p class="text-graphite-fg-2 leading-relaxed mb-4">
          Software Architecture focuses on the internal structure of software systems: components, modules, interfaces, and design patterns. Enterprise Architecture encompasses software architecture but extends to business processes, data flows, organizational structures, application portfolios, infrastructure, and the relationships between them.
        </p>
        <p class="text-graphite-fg-2 leading-relaxed">
          Enterprise Architecture considers the entire enterprise as a system of systems. Software architecture considers individual systems within that enterprise. Both are necessary. Enterprise Architecture provides the context that makes software architecture decisions consistent and strategically aligned.
        </p>
      </div>
      <div data-reveal class="md:col-span-2">
        <h3 class="text-xl font-display font-semibold text-graphite-fg mb-4">Common misconceptions</h3>
        <div class="grid gap-4 md:grid-cols-2">
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA is not just documentation.</strong> Architecture artifacts are tools for decision-making, not shelfware. The value is in the analysis, decisions, and governance, not the diagrams.</span>
            </li>
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA is not an ivory tower.</strong> Effective EA is embedded in delivery teams, guiding decisions with practical standards and real engagement.</span>
            </li>
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA does not slow innovation.</strong> Clear architecture standards and governance accelerate delivery by reducing rework, integration failures, and decision paralysis.</span>
            </li>
          </ul>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA is not IT-only.</strong> Business capabilities, processes, data, and strategy are core EA domains. EA is a business discipline enabled by technology.</span>
            </li>
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA is not a one-time project.</strong> Architecture is never finished. Markets, technology, and business strategy evolve. EA is a continuous practice, not a project with an end date.</span>
            </li>
            <li class="flex items-start gap-3 text-graphite-fg-2">
              <span class="block h-1.5 w-1.5 rounded-full bg-accent-bright mt-2 shrink-0" aria-hidden="true" />
              <span><strong class="text-graphite-fg">EA does not require a giant framework.</strong> We apply as much framework as needed. Pragmatic EA adapts TOGAF, ArchiMate, and other methods to your organizational context.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. BUSINESS CHALLENGES -->
<section class="py-20 md:py-28" aria-labelledby="challenges-heading">
  <div class="container-x">
    <SectionHeading
      id="challenges-heading"
      index="03"
      label="Business Challenges"
      title="The cost of operating without coherent architecture."
      lede="Organizations that neglect Enterprise Architecture accumulate structural complexity that erodes agility, inflates costs, and constrains growth. These are the symptoms we see across every industry."
    />
    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">01</span>
          <h3 class="font-display font-semibold text-ink">Legacy systems</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Aging mainframes and monolithic applications become increasingly expensive to maintain, difficult to integrate, and risky to change. Skilled maintainers retire. Vendor support ends.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">02</span>
          <h3 class="font-display font-semibold text-ink">Technology sprawl</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Hundreds of unmanaged tools, platforms, and frameworks accumulate across the organization. Duplicate capabilities, unsupported versions, and integration complexity spiral out of control.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">03</span>
          <h3 class="font-display font-semibold text-ink">Poor system integration</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Point-to-point integrations create brittle, untestable connections between systems. Changes propagate unpredictably. Integration failures become a leading cause of incidents.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">04</span>
          <h3 class="font-display font-semibold text-ink">Lack of governance</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Without architecture governance, teams make independent technology decisions that create inconsistency, security gaps, and integration problems.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">05</span>
          <h3 class="font-display font-semibold text-ink">Slow digital transformation</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Digital initiatives stall due to unclear architecture direction, unplanned dependencies, and the complexity of navigating existing systems. Transformation becomes a series of failed projects.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">06</span>
          <h3 class="font-display font-semibold text-ink">High IT costs</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Duplicate applications, over-provisioned infrastructure, unused licenses, and maintenance of low-value systems inflate IT spend without proportional business value.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">07</span>
          <h3 class="font-display font-semibold text-ink">Security and compliance risks</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Inconsistent security controls, unpatched systems, unknown data flows, and undocumented architectures create compliance gaps and expose the organization to breaches and regulatory penalties.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">08</span>
          <h3 class="font-display font-semibold text-ink">Duplicate applications</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Multiple applications serving the same business function, each with its own data store, integration pattern, and support team. Maintenance costs multiply without additional business value.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">09</span>
          <h3 class="font-display font-semibold text-ink">Data silos</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Business-critical data trapped in application-specific databases with no shared schema, governance, or integration. Reporting requires manual extraction and reconciliation across sources.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">10</span>
          <h3 class="font-display font-semibold text-ink">Inconsistent technology standards</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Every team chooses its own frameworks, languages, and platforms. Skills are fragmented. Organizational mobility is reduced. No single team can work across the entire portfolio.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">11</span>
          <h3 class="font-display font-semibold text-ink">Cloud migration complexity</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">Migrating to the cloud without architecture clarity leads to lift-and-shift of legacy problems, cost overruns, and architectures that fail to leverage cloud-native capabilities.</p>
      </div>
      <div class="rounded-lg border border-line-2 bg-paper p-6" data-reveal>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">12</span>
          <h3 class="font-display font-semibold text-ink">Limited business agility</h3>
        </div>
        <p class="text-sm text-ink-2 leading-relaxed">When technology is rigid and tightly coupled, the business cannot respond to market changes quickly. Every new initiative requires months of dependency analysis and integration work.</p>
      </div>
    </div>
  </div>
</section>

<!-- 4. OUR ENTERPRISE ARCHITECTURE APPROACH -->
<section class="py-20 md:py-28 bg-graphite" aria-labelledby="approach-heading">
  <div class="container-x">
    <SectionHeading
      id="approach-heading"
      index="04"
      label="Our Approach"
      title="A phased methodology for architecture transformation."
      lede="We follow a structured, business-outcome-driven approach to Enterprise Architecture. Every phase is tailored to your organizational context, maturity level, and strategic priorities."
      tone="graphite"
    />
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">01</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Business Capability Assessment</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Map the organization's business capabilities, their maturity, and their supporting technology. Identify capability gaps, redundancies, and opportunities for optimization.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">02</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Current-State Architecture Assessment</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Document and analyze the existing architecture: applications, data flows, integrations, infrastructure, security controls, and governance maturity. Baseline every domain.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">03</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Future-State Vision</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define the target architecture aligned with business strategy. Business capabilities, application portfolio, data architecture, technology platform, and governance model for the desired future state.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">04</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Technology Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Develop the technology strategy that bridges current and future states. Technology standards, platform decisions, build-vs-buy recommendations, and innovation priorities.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">05</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Architecture Roadmap</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Create a phased, multi-year architecture roadmap with prioritized work streams, milestones, dependencies, and business outcomes mapped to each phase.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">06</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Portfolio Rationalization</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Analyze the application and technology portfolio to identify retirement, consolidation, migration, and investment candidates. Reduce duplication and technical debt systematically.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">07</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Cloud Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Define the cloud adoption strategy: which workloads migrate, which stay on-premises, cloud provider selection, landing zone design, and cloud operating model.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">08</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Integration Strategy</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Design the enterprise integration architecture: API gateways, event brokers, service mesh, integration platforms, and data synchronization patterns across the entire landscape.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">09</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Governance Framework</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Establish architecture governance: principles, standards, review processes, decision records, architecture review boards, and exception management procedures.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">10</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Implementation Planning</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Translate the roadmap into actionable implementation plans: project initiation, resource allocation, dependency management, risk mitigation, and success criteria.</p>
      </div>
      <div class="rounded-lg border border-graphite-line bg-graphite-2 p-6" data-reveal>
        <span class="block font-mono text-xs text-accent-bright mb-3">11</span>
        <h3 class="font-display font-semibold text-graphite-fg mb-2">Continuous Architecture Review</h3>
        <p class="text-sm text-graphite-fg-2 leading-relaxed">Establish ongoing architecture review cycles to monitor alignment, assess new initiatives, update roadmaps, and evolve standards as business needs and technology change.</p>
      </div>
    </div>
  </div>
</section>

<!-- 5. ENTERPRISE ARCHITECTURE SERVICES -->
<section class="py-20 md:py-28" aria-labelledby="services-heading">
  <div class="container-x">
    <SectionHeading
      id="services-heading"
      index="05"
      label="Our Services"
      title="Comprehensive enterprise architecture capabilities."
      lede="From strategic advisory to hands-on architecture delivery, we provide the full spectrum of services needed to design, govern, and evolve your enterprise technology ecosystem."
    />
    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      
      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Enterprise Architecture Consulting</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Strategic architecture advisory for CIOs, CTOs, and Chief Architects. Define architecture vision, establish governance, and align technology strategy with business outcomes.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Architecture strategy and vision</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Executive advisory and board support</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Architecture team coaching</li>
        </ul>
      </div>

      <div class="rounded-lg border border-line-2 bg-paper p-7" data-reveal>
        <div class="font-mono text-xs text-accent mb-3">SERVICE</div>
        <h3 class="text-lg font-display font-semibold text-ink mb-2">Business Architecture</h3>
        <p class="text-sm text-ink-2 leading-relaxed mb-4">Map business capabilities, value streams, processes, and organizational structures. Align business strategy with technology investments and identify capability gaps.</p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Capability mapping and maturity assessment</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Value stream analysis</li>
          <li class="flex items-center gap-2 text-xs text-ink-3"><span class="block h-1 w-1 rounded-full bg-accent" aria-hidden="true" /> Business process modeling</li>
