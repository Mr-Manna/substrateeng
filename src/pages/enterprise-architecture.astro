<section class="py-20 md:py-28" aria-labelledby="framework-heading">
  <div class="container-x">
    <SectionHeading
      id="framework-heading"
      index="07"
      label="Enterprise Architecture Framework"
      title="A layered framework for enterprise-wide architecture design."
      lede="We organize Enterprise Architecture across ten integrated layers. Each layer represents a distinct architectural concern with its own standards, patterns, and governance. Together they form a coherent, end-to-end architecture description."
