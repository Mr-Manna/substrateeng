---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Mission from '../components/sections/Mission.astro';
import Scale from '../components/sections/Scale.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Industries from '../components/sections/Industries.astro';
import Technology from '../components/sections/Technology.astro';
import Process from '../components/sections/Process.astro';
import Work from '../components/sections/Work.astro';
import Insights from '../components/sections/Insights.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import { useTranslations } from '../i18n/useTranslations';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
---

<Base
  title={t('site.title')}
  description={t('site.description')}
  locale={locale}
>
  <Hero />
  <Mission />
  <Scale />
  <Capabilities />
  <Industries />
  <Technology />
  <Process />
  <Work />
  <Insights />
  <Certifications />
  <Contact />
</Base>
